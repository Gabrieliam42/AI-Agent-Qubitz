{
  "version": 1,
  "capabilities": {
    "serena": {
      "enabled": false,
      "cost_policy": "self_hosted",
      "transport": "stdio",
      "command": "serena",
      "args": ["start-mcp-server"],
      "runtime_env": {"SERENA_HOME": "{runtime}/.cache/mcp/serena-state"},
      "timeout_seconds": 120
    },
    "github": {
      "enabled": false,
      "cost_policy": "free",
      "transport": "stdio",
      "command": "github-mcp-server",
      "args": ["stdio"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "QUBITZ_GITHUB_TOKEN"},
      "allow_remote_mutations": false
    },
    "context7": {
      "enabled": false,
      "cost_policy": "free",
      "transport": "streamable_http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "enabled": false,
      "cost_policy": "self_hosted",
      "transport": "stdio",
      "command": "playwright-mcp",
      "args": [],
      "timeout_seconds": 90
    },
    "dbhub": {
      "enabled": false,
      "cost_policy": "self_hosted",
      "transport": "stdio",
      "command": "dbhub",
      "args": ["--transport", "stdio", "--config", "{runtime}/.qubitz/dbhub.readonly.toml"],
      "workspaces": [],
      "read_only_credentials_confirmed": false,
      "env": {"QUBITZ_DATABASE_DSN": "QUBITZ_DATABASE_DSN"}
    },
    "firecrawl": {
      "enabled": false,
      "cost_policy": "self_hosted",
      "transport": "stdio",
      "command": "firecrawl-mcp",
      "args": [],
      "env": {"FIRECRAWL_API_URL": "QUBITZ_FIRECRAWL_API_URL"}
    },
    "brave": {
      "enabled": false,
      "cost_policy": "free",
      "transport": "stdio",
      "command": "brave-search-mcp-server",
      "args": [],
      "env": {"BRAVE_API_KEY": "QUBITZ_BRAVE_API_KEY"}
    },
    "sequential_thinking": {
      "enabled": false,
      "cost_policy": "self_hosted",
      "transport": "stdio",
      "command": "mcp-server-sequential-thinking",
      "args": [],
      "runtime_env": {"DISABLE_THOUGHT_LOGGING": "true"}
    }
  }
}
