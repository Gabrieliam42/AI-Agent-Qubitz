+++ b/src/llama-model-loader.cpp
@@ -27,6 +27,33 @@
 #include <atomic>
 #include <mutex>
 #include <cstring>
+
+#ifdef __linux__
+#include <fcntl.h>
+#include <unistd.h>
+
+static void release_uploaded_mmap_pages(llama_mmap & mapping, int fd, size_t offset, size_t bytes) {
+    const long page_query = sysconf(_SC_PAGESIZE);
+    if (page_query <= 0) {
+        throw std::runtime_error("Cannot verify page size for bounded tensor uploads");
+    }
+    const size_t page = size_t(page_query);
+    const size_t skip = (page - offset % page) % page;
+    if (bytes <= skip) {
+        return;
+    }
+    const size_t length = (bytes - skip) / page * page;
+    if (length == 0) {
+        return; // A zero-length fadvise request would discard through EOF.
+    }
+    const size_t first = offset + skip;
+    mapping.dontneed_fragment(first, first + length);
+    const int error = posix_fadvise(fd, off_t(first), off_t(length), POSIX_FADV_DONTNEED);
+    if (error != 0) {
+        throw std::runtime_error(format("Cannot release uploaded tensor file-cache pages: %s", strerror(error)));
+    }
+}
+#endif
 
