# <QUBITZ_SHARED_SYMBOL:base:2e682607b304ca51> module/ClassDef:RepoRetriever:0
class RepoRetriever:
    def __init__(self, config: AgentConfig, progress_callback: Callable[[str], None] | None = None) -> None:
        self.config = config
        self.workspace = config.workspace.resolve()
        self.runtime_workspace = config_runtime_workspace(config)
        self.progress_callback = progress_callback
        self.cache_dir = self.runtime_workspace / ".cache" / "retrieval" / workspace_cache_key(self.workspace)
        self.cache_dir.mkdir(parents=True, exist_ok=True)
        self.manifest_path = self.cache_dir / "manifest.json"
        self.vectors_path = self.cache_dir / "vectors.npy"
        self.embedder = BGECodeEmbedder(
            self.runtime_workspace,
            config.embed_model_name,
            device=config.embed_device,
            local_files_only=config.local_files_only,
            min_free_vram_gib=config.embed_min_free_vram_gib,
            reserve_vram_gib=config.retrieval_gpu_reserve_gib,
            progress_callback=self._report,
        )
        self._chunks: list[RepoChunk] = []
        self._vectors: Any = None
        self._backend = "lexical"
        self._last_error: str | None = None
        self._faiss: Any = None
        self._faiss_gpu_resources: Any = None
        self._faiss_index: Any = None
        self._faiss_search_params: Any = None
        self._rmm_pool: Any = None
        self._rmm_configured = False
        self._rmm_attempted = False

    def _report(self, message: str) -> None:
        if self.progress_callback is not None:
            self.progress_callback(message)

    @staticmethod
    def _normalize_backend_name(name: str) -> str:
        normalized = name.strip().lower().replace("-", "_")
        aliases = {
            "": "auto",
            "flat_cuvs": "flat",
            "gpu_flat": "flat",
            "ivfflat": "ivf_flat",
            "ivf": "ivf_flat",
            "ivfpq": "ivf_pq",
            "pq": "ivf_pq",
            "ann": "cagra",
        }
        return aliases.get(normalized, normalized)

    def _effective_nlist(self) -> int:
        vector_count = int(self._vectors.shape[0]) if self._vectors is not None else 0
        if vector_count <= 1:
            return 1
        suggested = max(1, int(vector_count**0.5))
        return max(1, min(self.config.retrieval_ivf_nlist, suggested, vector_count))

    def _effective_nprobe(self, nlist: int) -> int:
        return max(1, min(self.config.retrieval_ivf_nprobe, nlist))

    def _effective_pq_m(self, dimension: int) -> int:
        requested = max(1, min(self.config.retrieval_ivfpq_m, dimension))
        for candidate in range(requested, 0, -1):
            if dimension % candidate == 0:
                return candidate
        return 1

    def recommended_result_limit(self) -> int:
        upper = max(1, self.config.max_repo_chunks)
        lower = max(1, min(self.config.min_repo_chunks, upper))
        tokens_per_chunk = max(1024, self.config.repo_chunk_ctx_tokens)
        adaptive = max(1, self.config.num_ctx // tokens_per_chunk)
        return max(lower, min(upper, adaptive))

    def _configure_rmm_pool(self) -> None:
        if self._rmm_attempted or self.config.retrieval_rmm_pool_gib <= 0:
            return
        self._rmm_attempted = True
        try:
            import rmm
        except Exception as exc:  # pragma: no cover - optional dependency path
            self._report(
                "RMM pooling was requested but the rmm-cu12 package is unavailable: "
                f"{type(exc).__name__}: {exc}"
            )
            return
        pool_bytes = int(self.config.retrieval_rmm_pool_gib * 1024**3)
        if pool_bytes <= 0:
            return
        try:
            pool = rmm.mr.PoolMemoryResource(
                rmm.mr.CudaMemoryResource(),
                initial_pool_size=pool_bytes,
            )
            try:
                rmm.mr.set_per_device_resource(0, pool)
            except TypeError:
                rmm.mr.set_per_device_resource(pool)
            self._rmm_pool = pool
            self._rmm_configured = True
            self._report(
                "Enabled RMM pooling for cuVS-backed retrieval with initial pool size "
                f"{format_bytes(pool_bytes)}."
            )
        except Exception as exc:  # pragma: no cover - optional dependency path
            self._report(f"RMM pool setup failed; continuing without pooling: {type(exc).__name__}: {exc}")

    def _new_gpu_resources(self, faiss: Any) -> Any:
        self._configure_rmm_pool()
        return faiss.StandardGpuResources()

    def _build_gpu_flat_index(self, faiss: Any) -> tuple[Any, str, Any]:
        cpu_index = faiss.IndexFlatIP(int(self._vectors.shape[1]))
        cpu_index.add(self._vectors)
        co = faiss.GpuClonerOptions()
        backend = "faiss-gpu-flat"
        if hasattr(co, "use_cuvs"):
            co.use_cuvs = True
            backend = "faiss-gpu-flat-cuvs"
        return faiss.index_cpu_to_gpu(self._faiss_gpu_resources, 0, cpu_index, co), backend, None

    def _build_gpu_ivf_flat_index(self, faiss: Any) -> tuple[Any, str, Any]:
        dimension = int(self._vectors.shape[1])
        nlist = self._effective_nlist()
        nprobe = self._effective_nprobe(nlist)
        config = faiss.GpuIndexIVFFlatConfig()
        config.use_cuvs = True
        index = faiss.GpuIndexIVFFlat(
            self._faiss_gpu_resources,
            dimension,
            nlist,
            faiss.METRIC_INNER_PRODUCT,
            config,
        )
        index.train(self._vectors)
        index.add(self._vectors)
        index.nprobe = nprobe
        backend = f"faiss-gpu-ivf-flat-cuvs(nlist={nlist},nprobe={nprobe})"
        return index, backend, None

    def _build_gpu_ivf_pq_index(self, faiss: Any) -> tuple[Any, str, Any]:
        dimension = int(self._vectors.shape[1])
        nlist = self._effective_nlist()
        nprobe = self._effective_nprobe(nlist)
        pq_m = self._effective_pq_m(dimension)
        pq_bits = max(4, min(16, self.config.retrieval_ivfpq_bits))
        config = faiss.GpuIndexIVFPQConfig()
        config.use_cuvs = True
        index = faiss.GpuIndexIVFPQ(
            self._faiss_gpu_resources,
            dimension,
            nlist,
            pq_m,
            pq_bits,
            faiss.METRIC_INNER_PRODUCT,
            config,
        )
        index.train(self._vectors)
        index.add(self._vectors)
        index.nprobe = nprobe
        backend = f"faiss-gpu-ivf-pq-cuvs(nlist={nlist},nprobe={nprobe},m={pq_m},bits={pq_bits})"
        return index, backend, None

    def _build_gpu_cagra_index(self, faiss: Any) -> tuple[Any, str, Any]:
        dimension = int(self._vectors.shape[1])
        config = faiss.GpuIndexCagraConfig()
        config.use_cuvs = True
        config.graph_degree = max(1, self.config.retrieval_cagra_graph_degree)
        config.intermediate_graph_degree = max(
            config.graph_degree,
            self.config.retrieval_cagra_intermediate_graph_degree,
        )
        index = faiss.GpuIndexCagra(
            self._faiss_gpu_resources,
            dimension,
            faiss.METRIC_INNER_PRODUCT,
            config,
        )
        index.train(self._vectors)
        params = faiss.SearchParametersCagra()
        params.search_width = max(1, self.config.retrieval_cagra_search_width)
        backend = (
            "faiss-gpu-cagra("
            f"graph_degree={config.graph_degree},"
            f"intermediate_degree={config.intermediate_graph_degree},"
            f"search_width={params.search_width})"
        )
        return index, backend, params

    def _iter_files(self) -> Iterable[Path]:
        for path in iter_workspace_files(self.workspace, EXCLUDED_DIRS):
            if is_excluded_retrieval_file(path):
                continue
            if not is_probably_text_file(path):
                continue
            yield path

    def _chunk_file(self, path: Path) -> list[RepoChunk]:
        text = path.read_text(encoding="utf-8", errors="ignore")
        lines = text.splitlines()
        if not lines:
            return []
        chunks: list[RepoChunk] = []
        chunk_size = 80
        overlap = 20
        start = 0
        rel = relative_path(path, self.workspace)
        while start < len(lines):
            end = min(len(lines), start + chunk_size)
            chunk_lines = lines[start:end]
            chunk_text = "\n".join(chunk_lines).strip()
            if chunk_text:
                chunk_id = f"{rel}:{start + 1}-{end}"
                chunks.append(
                    RepoChunk(
                        chunk_id=chunk_id,
                        path=rel,
                        start_line=start + 1,
                        end_line=end,
                        text=chunk_text,
                    )
                )
            if end >= len(lines):
                break
            start = max(end - overlap, start + 1)
        return chunks

    def _file_state(self) -> dict[str, dict[str, int]]:
        state: dict[str, dict[str, int]] = {}
        for path in self._iter_files():
            stat = path.stat()
            state[relative_path(path, self.workspace)] = {"mtime_ns": stat.st_mtime_ns, "size": stat.st_size}
        return state

    def _build_chunks(self) -> list[RepoChunk]:
        chunks: list[RepoChunk] = []
        files = sorted(self._iter_files())
        self._report(f"Scanning {len(files)} workspace file(s) for retrieval chunks.")
        for path in files:
            chunks.extend(self._chunk_file(path))
        self._report(f"Built {len(chunks)} retrieval chunk(s).")
        return chunks

    def _load_manifest(self) -> dict[str, Any] | None:
        if not self.manifest_path.exists():
            return None
        try:
            manifest = json.loads(self.manifest_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return None
        return manifest if isinstance(manifest, dict) else None

    def _load_vectors_array(self) -> Any:
        if not self.vectors_path.exists():
            return None
        import numpy as np

        return np.load(self.vectors_path, allow_pickle=False)

    def _hydrate_cached_manifest(self, manifest: dict[str, Any], vectors: Any | None = None) -> bool:
        chunk_dicts = manifest.get("chunks") or []
        try:
            self._chunks = [RepoChunk(**chunk_dict) for chunk_dict in chunk_dicts]
        except TypeError:
            return False
        if vectors is None and self.vectors_path.exists():
            try:
                vectors = self._load_vectors_array()
            except Exception:
                return False
        if vectors is not None:
            if len(vectors) != len(self._chunks):
                return False
            self._vectors = vectors
            self._backend = manifest.get("backend", "embedding")
            self._report(
                f"Loaded cached retrieval vectors for {len(self._chunks)} chunk(s) from {relative_path(self.vectors_path, self.workspace)}."
            )
        else:
            self._vectors = None
            self._backend = str(manifest.get("backend", "lexical"))
        return True

    def _load_cached(self, state: dict[str, dict[str, int]]) -> bool:
        manifest = self._load_manifest()
        if manifest is None:
            return False
        if manifest.get("file_state") != state:
            return False
        return self._hydrate_cached_manifest(manifest)

    def _reuse_cached_chunks(self, state: dict[str, dict[str, int]]) -> bool:
        manifest = self._load_manifest()
        if manifest is None:
            return False
        cached_state = manifest.get("file_state")
        if not isinstance(cached_state, dict) or cached_state == state:
            return False
        chunk_dicts = manifest.get("chunks") or []
        try:
            cached_chunks = [RepoChunk(**chunk_dict) for chunk_dict in chunk_dicts]
        except TypeError:
            return False
        cached_vectors = None
        if self.vectors_path.exists():
            try:
                cached_vectors = self._load_vectors_array()
            except Exception:
                cached_vectors = None
        if cached_vectors is not None and len(cached_vectors) != len(cached_chunks):
            cached_vectors = None

        cached_by_path: dict[str, list[tuple[RepoChunk, Any | None]]] = {}
        for index, chunk in enumerate(cached_chunks):
            vector = cached_vectors[index] if cached_vectors is not None else None
            cached_by_path.setdefault(chunk.path, []).append((chunk, vector))

        files = sorted(self._iter_files())
        new_chunks: list[RepoChunk] = []
        vector_slots: list[Any | None] = []
        pending_embed_chunks: list[RepoChunk] = []
        pending_embed_positions: list[int] = []
        reused_files = 0
        changed_files = 0
        reused_chunks = 0
        regenerated_chunks = 0

        for path in files:
            rel = relative_path(path, self.workspace)
            cached_entries = cached_by_path.get(rel, [])
            if cached_state.get(rel) == state.get(rel) and cached_entries:
                reused_files += 1
                for chunk, vector in cached_entries:
                    new_chunks.append(chunk)
                    if vector is not None:
                        vector_slots.append(vector)
                        reused_chunks += 1
                    else:
                        vector_slots.append(None)
                        pending_embed_chunks.append(chunk)
                        pending_embed_positions.append(len(vector_slots) - 1)
                        regenerated_chunks += 1
                continue

            changed_files += 1
            cached_by_id = {chunk.chunk_id: (chunk, vector) for chunk, vector in cached_entries}
            for chunk in self._chunk_file(path):
                new_chunks.append(chunk)
                cached_entry = cached_by_id.get(chunk.chunk_id)
                if cached_entry is not None and cached_entry[0].text == chunk.text and cached_entry[1] is not None:
                    vector_slots.append(cached_entry[1])
                    reused_chunks += 1
                else:
                    vector_slots.append(None)
                    pending_embed_chunks.append(chunk)
                    pending_embed_positions.append(len(vector_slots) - 1)
                    regenerated_chunks += 1

        if not new_chunks:
            self._chunks = []
            self._vectors = None
            self._backend = "lexical"
            self._last_error = None
            self._reset_faiss_index()
            self._save_cached(state)
            self._report("Repository retrieval cache reused with no remaining source chunks.")
            return True

        self._chunks = new_chunks
        self._vectors = None
        self._backend = "lexical"
        self._last_error = None
        self._reset_faiss_index()
        self._report(
            "Retrieval cache changed; "
            f"reusing {reused_chunks} cached chunk vector(s) across {reused_files} unchanged file(s) "
            f"and rebuilding {regenerated_chunks} chunk(s) from {changed_files} changed or new file(s)."
        )

        if any(vector is not None for vector in vector_slots):
            try:
                import numpy as np

                if pending_embed_chunks:
                    self._report(
                        f"Generating repository embeddings for {len(pending_embed_chunks)} changed or uncached chunk(s)."
                    )
                    generated_vectors = self.embedder.encode_documents([chunk.text for chunk in pending_embed_chunks])
                    for position, vector in zip(pending_embed_positions, generated_vectors, strict=False):
                        vector_slots[position] = vector
                if all(vector is not None for vector in vector_slots):
                    self._vectors = np.asarray(vector_slots, dtype="float32")
                    self._backend = "embedding-numpy"
                    if self.embedder.load_warning:
                        self._last_error = self.embedder.load_warning
                    self._ensure_faiss_index()
            except Exception as exc:  # pragma: no cover - runtime fallback path
                self._last_error = f"{type(exc).__name__}: {exc}"
                self._vectors = None
                self._backend = "lexical"
        elif pending_embed_chunks:
            try:
                self._report(
                    f"Generating repository embeddings for {len(pending_embed_chunks)} changed or uncached chunk(s)."
                )
                self._vectors = self.embedder.encode_documents([chunk.text for chunk in pending_embed_chunks])
                self._backend = "embedding-numpy"
                if self.embedder.load_warning:
                    self._last_error = self.embedder.load_warning
                self._ensure_faiss_index()
            except Exception as exc:  # pragma: no cover - runtime fallback path
                self._last_error = f"{type(exc).__name__}: {exc}"
                self._vectors = None
                self._backend = "lexical"

        self._save_cached(state)
        return True

    def _save_cached(self, state: dict[str, dict[str, int]]) -> None:
        manifest = {
            "file_state": state,
            "chunks": [asdict(chunk) for chunk in self._chunks],
            "backend": self._backend,
        }
        self.manifest_path.write_text(json.dumps(manifest, ensure_ascii=True, indent=2), encoding="utf-8")
        if self._vectors is not None:
            import numpy as np

            np.save(self.vectors_path, self._vectors, allow_pickle=False)
        elif self.vectors_path.exists():
            self.vectors_path.unlink()

    def _reset_faiss_index(self) -> None:
        self._faiss_index = None
        self._faiss_gpu_resources = None
        self._faiss_search_params = None

    def _ensure_faiss_index(self) -> bool:
        if self._vectors is None:
            return False
        if self._faiss_index is not None:
            return True
        try:
            import faiss
        except Exception as exc:  # pragma: no cover - optional dependency path
            self._last_error = f"{type(exc).__name__}: {exc}"
            return False
        try:
            requested_backend = self._normalize_backend_name(self.config.retrieval_backend)
            cpu_index = faiss.IndexFlatIP(int(self._vectors.shape[1]))
            cpu_index.add(self._vectors)
            backend = "faiss-cpu-flat"
            gpu_count = faiss.get_num_gpus()
            if gpu_count > 0 and hasattr(faiss, "StandardGpuResources") and hasattr(faiss, "index_cpu_to_gpu"):
                try:
                    self._faiss_gpu_resources = self._new_gpu_resources(faiss)
                    if requested_backend in {"auto", "flat"}:
                        self._faiss_index, backend, self._faiss_search_params = self._build_gpu_flat_index(faiss)
                    elif requested_backend == "ivf_flat":
                        self._faiss_index, backend, self._faiss_search_params = self._build_gpu_ivf_flat_index(faiss)
                    elif requested_backend == "ivf_pq":
                        self._faiss_index, backend, self._faiss_search_params = self._build_gpu_ivf_pq_index(faiss)
                    elif requested_backend == "cagra":
                        self._faiss_index, backend, self._faiss_search_params = self._build_gpu_cagra_index(faiss)
                    else:
                        self._report(
                            f"Unknown retrieval backend '{self.config.retrieval_backend}', using flat cuVS search instead."
                        )
                        self._faiss_index, backend, self._faiss_search_params = self._build_gpu_flat_index(faiss)
                except Exception as exc:
                    self._last_error = f"{type(exc).__name__}: {exc}"
                    self._faiss_gpu_resources = None
                    self._faiss_index = cpu_index
                    self._faiss_search_params = None
                    backend = "faiss-cpu-flat"
                    self._report(
                        "FAISS GPU index allocation failed, falling back to CPU FAISS: "
                        f"{self._last_error}"
                    )
            else:
                if requested_backend not in {"auto", "flat"}:
                    self._report(
                        f"Retrieval backend '{requested_backend}' requires FAISS GPU support; using CPU flat search."
                    )
                self._faiss_index = cpu_index
            self._faiss = faiss
            self._backend = backend
            self._report(f"Retrieval index ready with backend {backend} over {len(self._chunks)} chunk(s).")
            return True
        except Exception as exc:  # pragma: no cover - runtime fallback path
            self._last_error = f"{type(exc).__name__}: {exc}"
            self._reset_faiss_index()
            return False

    def ensure_index(self) -> None:
        state = self._file_state()
        if self._load_cached(state):
            if not self._chunks and state:
                self._report("Cached retrieval chunk metadata is missing. Rebuilding repository index.")
            else:
                self._reset_faiss_index()
                if self._vectors is None and self._chunks:
                    self._report("Cached retrieval vectors are missing. Rebuilding embeddings from cached repository chunks.")
                    try:
                        self._vectors = self.embedder.encode_documents([chunk.text for chunk in self._chunks])
                        self._backend = "embedding-numpy"
                        if self.embedder.load_warning:
                            self._last_error = self.embedder.load_warning
                        self._ensure_faiss_index()
                    except Exception as exc:  # pragma: no cover - runtime fallback path
                        self._last_error = f"{type(exc).__name__}: {exc}"
                        self._vectors = None
                        self._backend = "lexical"
                    self._save_cached(state)
                    return
                self._ensure_faiss_index()
                return
        if self._reuse_cached_chunks(state):
            return
        self._report("Retrieval cache is stale or missing. Rebuilding repository index.")
        self._chunks = self._build_chunks()
        self._vectors = None
        self._backend = "lexical"
        self._last_error = None
        self._reset_faiss_index()
        if self._chunks:
            try:
                self._report("Generating repository embeddings.")
                self._vectors = self.embedder.encode_documents([chunk.text for chunk in self._chunks])
                self._backend = "embedding-numpy"
                if self.embedder.load_warning:
                    self._last_error = self.embedder.load_warning
                self._ensure_faiss_index()
            except Exception as exc:  # pragma: no cover - runtime fallback path
                self._last_error = f"{type(exc).__name__}: {exc}"
                self._vectors = None
                self._backend = "lexical"
        self._save_cached(state)

    def _lexical_scores(self, query: str) -> list[tuple[float, RepoChunk]]:
        query_tokens = token_set(query)
        scored: list[tuple[float, RepoChunk]] = []
        for chunk in self._chunks:
            lowered = chunk.text.lower()
            score = float(sum(lowered.count(token) for token in query_tokens))
            if any(token in chunk.path.lower() for token in query_tokens):
                score += 2.0
            if score > 0:
                scored.append((score, chunk))
        scored.sort(key=lambda item: item[0], reverse=True)
        return scored

    def query(self, query: str, limit: int | None = None) -> dict[str, Any]:
        import numpy as np

        self.ensure_index()
        top_k = limit or self.recommended_result_limit()
        results: list[dict[str, Any]] = []
        if not self._chunks:
            return {"backend": "empty", "results": [], "error": self._last_error}
        if self._vectors is not None:
            try:
                self._report(f"Retrieving repository context for query: {shorten(query, 100)}")
                query_vector = self.embedder.encode_queries([query])[0]
                if self._ensure_faiss_index():
                    search_kwargs: dict[str, Any] = {}
                    if self._faiss_search_params is not None:
                        search_kwargs["params"] = self._faiss_search_params
                    scores_array, indices_array = self._faiss_index.search(
                        np.ascontiguousarray(query_vector.reshape(1, -1), dtype="float32"),
                        top_k,
                        **search_kwargs,
                    )
                    top_indices = [int(index) for index in indices_array[0] if int(index) >= 0]
                    score_map = {
                        int(index): float(score)
                        for index, score in zip(indices_array[0], scores_array[0], strict=False)
                        if int(index) >= 0
                    }
                else:
                    scores = self._vectors @ query_vector
                    top_indices = [int(index) for index in np.argsort(scores)[::-1][:top_k]]
                    score_map = {int(index): float(scores[int(index)]) for index in top_indices}
                for index in top_indices:
                    chunk = self._chunks[int(index)]
                    results.append(
                        {
                            "path": chunk.path,
                            "start_line": chunk.start_line,
                            "end_line": chunk.end_line,
                            "score": score_map[int(index)],
                            "text": shorten(chunk.text, 1400),
                        }
                    )
            except Exception as exc:  # pragma: no cover - runtime fallback path
                self._last_error = f"{type(exc).__name__}: {exc}"
                self._reset_faiss_index()
                if self._vectors is not None:
                    scores = self._vectors @ query_vector
                    top_indices = [int(index) for index in np.argsort(scores)[::-1][:top_k]]
                    self._backend = "embedding-numpy"
                    for index in top_indices:
                        chunk = self._chunks[index]
                        results.append(
                            {
                                "path": chunk.path,
                                "start_line": chunk.start_line,
                                "end_line": chunk.end_line,
                                "score": float(scores[index]),
                                "text": shorten(chunk.text, 1400),
                            }
                        )
        if not results:
            for score, chunk in self._lexical_scores(query)[:top_k]:
                results.append(
                    {
                        "path": chunk.path,
                        "start_line": chunk.start_line,
                        "end_line": chunk.end_line,
                        "score": score,
                        "text": shorten(chunk.text, 1400),
                    }
                )
        if results:
            preview = ", ".join(f"{item['path']}:{item['start_line']}-{item['end_line']}" for item in results[:3])
            self._report(f"Repository context ready from {self._backend}: {preview}")
        return {"backend": self._backend, "results": results, "error": self._last_error}

    def format_context(self, query: str) -> str:
        query_result = self.query(query)
        lines = [f"Repository retrieval backend: {query_result['backend']}"]
        if query_result.get("error"):
            lines.append(f"Retrieval warning: {query_result['error']}")
        if not query_result["results"]:
            lines.append("No repository context was retrieved.")
            return "\n".join(lines)
        for item in query_result["results"]:
            lines.append(
                f"- {item['path']}:{item['start_line']}-{item['end_line']} score={item['score']:.3f}\n"
                f"  {item['text']}"
            )
        return "\n".join(lines)

    def release_gpu_resources(self) -> None:
        released: list[str] = []
        if self._faiss_index is not None and self._backend.startswith("faiss-gpu"):
            released.append("FAISS GPU index")
            self._backend = "embedding-numpy" if self._vectors is not None else self._backend
        self._reset_faiss_index()
        if self.embedder.release_gpu():
            released.append("embedder")
        if released:
            self._report(f"Released retrieval GPU resources before generation: {', '.join(released)}.")
