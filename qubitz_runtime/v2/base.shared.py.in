# <QUBITZ_SHARED_SYMBOL:base:2bc8439b21b320e0> module/FunctionDef:resolve_gguf_model_path:0/If:If:0
    if candidate_text:
        candidate_name = Path(candidate_text).name
        if candidate_name != preferred_filename:
            raise ValueError(
                f"Configured GGUF model must be {preferred_filename}, got {candidate_name!r}."
            )
        return resolve_workspace_path(
            workspace,
            candidate_text,
            allow_missing=False,
            allow_external=True,
        )
