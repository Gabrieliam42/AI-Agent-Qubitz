# <QUBITZ_SHARED_SYMBOL:base:58b553d4e6d6392a> module/FunctionDef:normalize_archive_root:0
def normalize_archive_root(extracted_dir: Path) -> Path:
    current = extracted_dir
    while True:
        children = sorted(current.iterdir())
        file_children = [child for child in children if child.is_file()]
        dir_children = [child for child in children if child.is_dir()]
        if file_children or len(dir_children) != 1:
            return current
        current = dir_children[0]
