# <QUBITZ_SHARED_SYMBOL:base:993c7a043e6e6f97> module/ClassDef:LlamaCppClient:0
class LlamaCppClient:
    def __init__(
        self,
        config: AgentConfig,
        transports: Sequence[DirectHTTPTransport | WindowsBridgeHTTPTransport],
        *,
        server_process: LlamaCppServerProcess | None = None,
    ) -> None:
        if not transports:
            raise ValueError("At least one llama.cpp transport is required.")
        self.config = config
        self.transports = list(transports)
        self.transport = self.transports[0]
        self.server_process = server_process

    @classmethod
    def detect(cls, config: AgentConfig) -> "LlamaCppClient":
        base_url = normalize_base_url(config.server_url or os.environ.get(LLAMACPP_SERVER_URL_ENV_NAME))
        transports = cls._reachable_transports(base_url)
        server_process: LlamaCppServerProcess | None = None
        if not transports:
            server_process = LlamaCppServerProcess(config)
            server_process.ensure_started()
            deadline = time.time() + 120.0
            while time.time() < deadline:
                transports = cls._reachable_transports(base_url)
                if transports:
                    break
                process = server_process.process
                if process is not None and process.poll() is not None:
                    log_tail = server_process.read_log_tail()
                    log_hint = f"\nServer log tail:\n{log_tail}" if log_tail else ""
                    raise RuntimeError(f"llama-server exited before it became ready.{log_hint}")
                time.sleep(0.5)
        if not transports:
            log_hint = ""
            if server_process is not None:
                log_tail = server_process.read_log_tail()
                if log_tail:
                    log_hint = f"\nServer log tail:\n{log_tail}"
            raise RuntimeError(
                "No reachable llama.cpp server was found. "
                f"Set {LLAMACPP_SERVER_URL_ENV_NAME} to an existing server, or install llama.cpp "
                f"and set {GGUF_MODEL_PATH_ENV_NAME}."
                f"{log_hint}"
            )
        return cls(config, transports, server_process=server_process)

    @staticmethod
    def _reachable_transports(base_url: str) -> list[DirectHTTPTransport | WindowsBridgeHTTPTransport]:
        transports: list[DirectHTTPTransport | WindowsBridgeHTTPTransport] = []
        direct = DirectHTTPTransport(base_url, "direct")
        try:
            probe = direct.probe_json("/v1/models")
            if int(probe.get("status_code") or 0) == 200 or LlamaCppClient._probe_reports_loading(probe):
                transports.append(direct)
        except Exception:
            pass
        if in_wsl() and shutil.which("powershell.exe") and not llamacpp_native_server_executable(Path.cwd()).exists():
            bridge = WindowsBridgeHTTPTransport(base_url)
            try:
                probe = bridge.probe_json("/v1/models")
                if int(probe.get("status_code") or 0) == 200 or LlamaCppClient._probe_reports_loading(probe):
                    transports.append(bridge)
            except Exception:
                pass
        return transports

    @property
    def label(self) -> str:
        return self.transport.label

    @property
    def base_url(self) -> str:
        return self.transport.base_url

    def shutdown(self) -> None:
        if self.server_process is not None:
            self.server_process.shutdown()

    def _call_with_fallback(self, method_name: str, *args: Any, **kwargs: Any) -> dict[str, Any]:
        errors: list[str] = []
        for index, transport in enumerate(list(self.transports)):
            try:
                result = getattr(transport, method_name)(*args, **kwargs)
            except Exception as exc:
                errors.append(f"{transport.label}: {type(exc).__name__}: {exc}")
                continue
            if index != 0:
                self.transports.insert(0, self.transports.pop(index))
            self.transport = self.transports[0]
            return result
        raise RuntimeError(" ; ".join(errors) or "All llama.cpp transports failed.")

    @staticmethod
    def _probe_reports_loading(probe: dict[str, Any]) -> bool:
        status_code = int(probe.get("status_code") or 0)
        if status_code == 200:
            return False
        payload = probe.get("json") or {}
        message = ""
        if isinstance(payload, dict):
            error_payload = payload.get("error")
            if isinstance(error_payload, dict):
                message = str(error_payload.get("message") or "")
        if not message:
            message = str(probe.get("text") or "")
        lowered = message.lower()
        return status_code in {425, 429, 503} and ("loading model" in lowered or "loading" in lowered)

    def _probe_with_fallback(self, path: str) -> dict[str, Any]:
        errors: list[str] = []
        for index, transport in enumerate(list(self.transports)):
            try:
                if hasattr(transport, "probe_json"):
                    result = transport.probe_json(path)
                else:
                    result = {
                        "status_code": 200,
                        "json": transport.get_json(path),
                        "text": "",
                    }
            except Exception as exc:
                errors.append(f"{transport.label}: {type(exc).__name__}: {exc}")
                continue
            if index != 0:
                self.transports.insert(0, self.transports.pop(index))
            self.transport = self.transports[0]
            return result
        return {"status_code": 0, "json": {}, "text": " ; ".join(errors)}

    def list_models(self) -> list[dict[str, Any]]:
        payload = self._call_with_fallback("get_json", "/v1/models")
        data = payload.get("data")
        return data if isinstance(data, list) else []

    def ensure_model(
        self,
        model_name: str,
        timeout_seconds: float = DEFAULT_LLAMACPP_MODEL_READY_TIMEOUT_SECONDS,
    ) -> str:
        deadline = time.time() + timeout_seconds
        models: list[dict[str, Any]] = []
        props_available = False
        saw_loading = False
        last_model_probe: dict[str, Any] = {}
        last_props_probe: dict[str, Any] = {}
        while time.time() < deadline:
            last_model_probe = self._probe_with_fallback("/v1/models")
            if int(last_model_probe.get("status_code") or 0) == 200:
                payload = last_model_probe.get("json") or {}
                data = payload.get("data")
                models = data if isinstance(data, list) else []
                if models:
                    break
            saw_loading = saw_loading or self._probe_reports_loading(last_model_probe)
            last_props_probe = self._probe_with_fallback("/props")
            if int(last_props_probe.get("status_code") or 0) == 200:
                props = last_props_probe.get("json") or {}
                props_available = bool(props)
            else:
                props_available = False
            saw_loading = saw_loading or self._probe_reports_loading(last_props_probe)
            if props_available:
                return model_name
            if self.server_process is not None:
                process = self.server_process.process
                if process is not None and process.poll() is not None:
                    log_tail = self.server_process.read_log_tail()
                    log_hint = f"\nServer log tail:\n{log_tail}" if log_tail else ""
                    raise RuntimeError(f"llama-server exited while the model was loading.{log_hint}")
            time.sleep(0.5)
        if not models:
            log_hint = ""
            if self.server_process is not None:
                log_tail = self.server_process.read_log_tail()
                if log_tail:
                    log_hint = f" Server log tail:\n{log_tail}"
            if saw_loading:
                raise RuntimeError(
                    f"llama.cpp server at {self.base_url} was still loading the model after {timeout_seconds:.0f}s."
                    f"{log_hint}"
                )
            probe_hint = ""
            if last_model_probe or last_props_probe:
                probe_hint = (
                    f" Last /v1/models probe: {shorten(json.dumps(last_model_probe, ensure_ascii=False), 800)}"
                    f" Last /props probe: {shorten(json.dumps(last_props_probe, ensure_ascii=False), 800)}"
                )
            raise RuntimeError(
                f"No model was advertised by {self.base_url} within {timeout_seconds:.0f}s. "
                "Verify that llama-server was started with a GGUF model and wait until loading finishes."
                f"{probe_hint}"
                f"{log_hint}"
            )
        for item in models:
            candidate = (item.get("id") or "").strip()
            if candidate == model_name:
                return model_name
        if len(models) == 1:
            only_id = (models[0].get("id") or "").strip()
            if only_id:
                return only_id
        available = ", ".join(item.get("id", "?") for item in models) or "none"
        raise RuntimeError(
            f"Model alias {model_name!r} is not available from {self.base_url}. Available: {available}"
        )

    def runtime_status(self, model_name: str) -> dict[str, Any] | None:
        for model in self.list_models():
            if (model.get("id") or "").strip() == model_name:
                return model
        return None

    def startup_diagnostics(self, model_name: str) -> dict[str, Any]:
        diagnostics: dict[str, Any] = {
            "transport": self.label,
            "base_url": self.base_url,
            "runtime": self.runtime_status(model_name),
            "launched": bool(
                self.server_process and self.server_process.process and self.server_process.process.poll() is None
            ),
        }
        if self.server_process is not None:
            try:
                diagnostics["model_path"] = str(self.server_process.resolve_model_path())
            except Exception as exc:
                diagnostics["model_path_error"] = f"{type(exc).__name__}: {exc}"
            try:
                diagnostics["server_executable"] = self.server_process.resolve_executable()
            except Exception as exc:
                diagnostics["server_executable_error"] = f"{type(exc).__name__}: {exc}"
            diagnostics["server_log_path"] = str(self.server_process.log_path)
            diagnostics["server_log_tail"] = self.server_process.read_log_tail()
        try:
            diagnostics["props"] = self._call_with_fallback("get_json", "/props")
        except Exception as exc:
            diagnostics["props_error"] = f"{type(exc).__name__}: {exc}"
        return diagnostics

    @staticmethod
    def _normalize_tool_calls(raw_tool_calls: Any) -> list[dict[str, Any]]:
        if not isinstance(raw_tool_calls, list):
            return []
        normalized: list[dict[str, Any]] = []
        for index, raw in enumerate(raw_tool_calls):
            if not isinstance(raw, dict):
                continue
            function = raw.get("function")
            if isinstance(function, dict):
                name = (function.get("name") or raw.get("name") or "").strip()
                arguments = function.get("arguments", raw.get("arguments"))
            else:
                name = (raw.get("name") or "").strip()
                arguments = raw.get("arguments")
            if not name:
                continue
            if not isinstance(arguments, str):
                arguments = json.dumps(arguments or {}, ensure_ascii=True)
            normalized.append(
                {
                    "id": raw.get("id") or f"call_{index + 1}",
                    "type": "function",
                    "function": {
                        "name": name,
                        "arguments": arguments,
                    },
                }
            )
        return normalized

    def chat(
        self,
        *,
        model_name: str,
        messages: list[dict[str, Any]],
        tools: list[dict[str, Any]],
        num_predict: int,
        temperature: float,
        top_p: float,
        min_p: float,
        repeat_penalty: float,
    ) -> dict[str, Any]:
        payload = {
            "model": model_name,
            "messages": messages,
            "stream": False,
            "tools": tools,
            "tool_choice": "auto",
            "parallel_tool_calls": False,
            "parse_tool_calls": True,
            "max_tokens": num_predict,
            "temperature": temperature,
            "top_p": top_p,
            "min_p": min_p,
            "repeat_penalty": repeat_penalty,
        }
        raw = self._call_with_fallback("post_json", "/v1/chat/completions", payload)
        choices = raw.get("choices") or []
        choice = choices[0] if choices else {}
        message = choice.get("message") or {}
        content = message.get("content") or ""
        if not isinstance(content, str):
            content = json.dumps(content, ensure_ascii=False)
        return {
            "message": {
                "role": "assistant",
                "content": content,
                "tool_calls": self._normalize_tool_calls(message.get("tool_calls")),
            },
            "usage": raw.get("usage") or {},
            "timings": raw.get("timings") or {},
            "finish_reason": choice.get("finish_reason"),
        }
