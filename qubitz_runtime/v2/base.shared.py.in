# <QUBITZ_SHARED_SYMBOL:base:15a512f75d9da597> module/FunctionDef:_sync_encrypted_harness_from_plaintext:0
def _sync_encrypted_harness_from_plaintext(workspace: Path, plaintext: str) -> None:
