# <QUBITZ_SHARED_SYMBOL:base:28551cc8e4258fd2> module/FunctionDef:strip_leading_python_launcher:0
def strip_leading_python_launcher(command: str) -> str:
    stripped = command.strip()
    patterns = (
        r"^(?:python(?:\.exe)?|py)\s+(?P<rest>.+)$",
        r"^(?:\.[\\/][^\s]*?(?:Scripts[\\/]python\.exe|bin[\\/]python))\s+(?P<rest>.+)$",
    )
    for pattern in patterns:
        match = re.match(pattern, stripped, flags=re.IGNORECASE)
        if match:
            return match.group("rest").strip()
    return stripped
