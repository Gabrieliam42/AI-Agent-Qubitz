# <QUBITZ_SHARED_SYMBOL:base:601f98469bc2a4a4> module/FunctionDef:normalize_workspace_directory:0
def normalize_workspace_directory(selection: str) -> Path:
    normalized = selection.strip().strip('"')
    if in_wsl() and WINDOWS_DRIVE_PATH_PATTERN.match(normalized):
        drive = normalized[0].lower()
        remainder = normalized[2:].replace("\\", "/").lstrip("/")
        return Path("/mnt") / drive / remainder if remainder else Path("/mnt") / drive
    return Path(normalized).expanduser()
