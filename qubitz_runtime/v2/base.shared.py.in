# <QUBITZ_SHARED_SYMBOL:base:a713fb7697b62a5e> module/FunctionDef:resolve_llama_server_executable:0
def resolve_llama_server_executable(workspace: Path, configured_path: str | None = None) -> str | None:
    configured = (configured_path or os.environ.get(LLAMACPP_SERVER_PATH_ENV_NAME) or "").strip()
    resolved_configured: Path | None = None
    if configured:
        if in_wsl() and WINDOWS_DRIVE_PATH_PATTERN.match(configured):
            drive = configured[0].lower()
            remainder = configured[2:].replace("\\", "/").lstrip("/")
            resolved_configured = Path("/mnt") / drive / remainder if remainder else Path("/mnt") / drive
        else:
            resolved_configured = Path(configured).expanduser()
        if resolved_configured.exists():
            return str(resolved_configured.resolve())
        found = shutil.which(configured)
        if found:
            return found
    if in_wsl():
        windows_runtime_executable = llamacpp_runtime_dir(workspace) / "llama-server.exe"
        if windows_runtime_executable.exists():
            return str(windows_runtime_executable.resolve())
        native_executable = llamacpp_native_server_executable(workspace)
        if native_executable.exists():
            return str(native_executable.resolve())
        try:
            ensured = ensure_project_local_llamacpp_runtime(workspace)
        except Exception:
            native_info = ensure_project_local_native_llamacpp_runtime(workspace)
            return str(Path(native_info["executable"]))
        return str(Path(ensured["executable"]))
    ensured = ensure_project_local_llamacpp_runtime(workspace)
    return str(Path(ensured["executable"]))
