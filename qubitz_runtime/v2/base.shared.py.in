# <QUBITZ_SHARED_SYMBOL:base:27dc920a51d573ab> module/Assign:Name(id='VERIFY_INTENT_PATTERN', ctx=Store()):0
VERIFY_INTENT_PATTERN = re.compile(
    r"\b(test|verify|validate|validation|lint|ruff|pytest|smoke\s+test|regression)\b",
    re.IGNORECASE,
)
