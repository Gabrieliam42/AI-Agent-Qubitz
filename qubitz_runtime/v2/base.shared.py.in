# <QUBITZ_SHARED_SYMBOL:base:913ceb6b0b9b5fd8> module/Assign:Name(id='MAX_DIRECT_READ_CHARS', ctx=Store()):0
MAX_DIRECT_READ_CHARS = 12000
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:915b77f9a3826fe9> module/FunctionDef:extract_file_tokens:0
def extract_file_tokens(text: str) -> list[str]:
    tokens: list[str] = []
    for match in FILE_TOKEN_PATTERN.finditer(text):
        candidate = next((group for group in match.groups() if group), "")
        candidate = candidate.strip().strip("()[]{}<>.,:;")
        if not candidate:
            continue
        if candidate.startswith(("http://", "https://")):
            continue
        tokens.append(candidate)
    return tokens
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:91f5c26316a6d44c> module/FunctionDef:is_excluded_retrieval_file:0
def is_excluded_retrieval_file(path: Path) -> bool:
    if path.name.endswith(".bak"):
        return True
    if path.name in EXCLUDED_RETRIEVAL_FILENAMES:
        return True
    return any(path.name.endswith(suffix) for suffix in EXCLUDED_RETRIEVAL_SUFFIXES)
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:928e5338f502617c> module/FunctionDef:extract_zip_to_dir:0
def extract_zip_to_dir(zip_path: Path, destination_dir: Path) -> None:
    if destination_dir.exists():
        shutil.rmtree(destination_dir)
    destination_dir.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(zip_path) as archive:
        archive.extractall(destination_dir)
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:92edd274cdb43746> module/ClassDef:DirectHTTPTransport:0
class DirectHTTPTransport:
    def __init__(self, base_url: str, label: str) -> None:
        self.base_url = base_url.rstrip("/")
        self.label = label

    def probe_json(self, path: str, timeout: float = 20.0) -> dict[str, Any]:
        import httpx

        with httpx.Client(timeout=timeout) as client:
            response = client.get(f"{self.base_url}{path}")
            text = response.text
            try:
                payload = response.json()
            except ValueError:
                payload = {}
            return {
                "status_code": response.status_code,
                "json": payload if isinstance(payload, dict) else {},
                "text": text,
            }

    def get_json(self, path: str) -> dict[str, Any]:
        probe = self.probe_json(path)
        status_code = int(probe.get("status_code") or 0)
        if status_code < 200 or status_code >= 300:
            raise RuntimeError(
                f"HTTP {status_code} for {self.base_url}{path}: "
                f"{shorten(str(probe.get('text') or probe.get('json') or ''), 300)}"
            )
        return probe.get("json") or {}

    def post_json(self, path: str, payload: dict[str, Any]) -> dict[str, Any]:
        import httpx

        with httpx.Client(timeout=600.0) as client:
            response = client.post(f"{self.base_url}{path}", json=payload)
            response.raise_for_status()
            return response.json()
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:93ad1ec54e60b053> module/FunctionDef:is_windows_backed_workspace:0
def is_windows_backed_workspace(workspace: Path) -> bool:
    resolved = workspace.resolve().as_posix()
    if WINDOWS_DRIVE_PATH_PATTERN.match(resolved):
        return True
    return resolved.startswith("/mnt/") and len(resolved) >= 7 and resolved[5].isalpha() and resolved[6] == "/"
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:9467140c778aa4cb> module/FunctionDef:extract_tar_to_dir:0
def extract_tar_to_dir(tar_path: Path, destination_dir: Path) -> None:
    if destination_dir.exists():
        shutil.rmtree(destination_dir)
    destination_dir.mkdir(parents=True, exist_ok=True)
    with tarfile.open(tar_path, mode="r:gz") as archive:
        archive.extractall(destination_dir)
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:9497a11309f3284a> module/FunctionDef:iter_workspace_files:0
def iter_workspace_files(workspace: Path, excluded_dirs: set[str]) -> Iterable[Path]:
    for root, dirnames, filenames in os.walk(workspace, topdown=True):
        dirnames[:] = [dirname for dirname in dirnames if not is_excluded_dir_name(dirname, excluded_dirs)]
        root_path = Path(root)
        for filename in filenames:
            yield root_path / filename
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:954ee7e66b1fb895> module/FunctionDef:resolve_allowed_project_command:0
def resolve_allowed_project_command(workspace: Path, command: Sequence[str]) -> list[str]:
    if not command:
        raise ValueError("Command cannot be empty.")
    normalized_command = list(command)
    executable = normalize_workspace_text(command[0])
    normalized_command[0] = executable
    if executable in ALLOWED_COMMANDS:
        return normalized_command
    try:
        resolved_executable = resolve_workspace_path(workspace, executable, allow_missing=False, allow_external=True)
    except Exception:
        resolved_executable = None
    if resolved_executable is not None:
        allowed_pythons = {candidate.resolve() for candidate in project_python_candidates(workspace) if candidate.exists()}
        if resolved_executable in allowed_pythons:
            normalized_command[0] = str(resolved_executable)
            return normalized_command
    raise ValueError(f"Command is not allowed: {command[0]}")
