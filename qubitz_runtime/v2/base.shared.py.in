# <QUBITZ_SHARED_SYMBOL:base:39c3cd7def2eccf0> module/FunctionDef:wsl_path_to_windows:0
def wsl_path_to_windows(path: Path) -> str | None:
    if not in_wsl():
        return None
    parts = path.expanduser().resolve().as_posix().split("/")
    if len(parts) < 3 or parts[1] != "mnt":
        return None
    drive = parts[2]
    if len(drive) != 1 or not drive.isalpha():
        return None
    remainder = "\\".join(parts[3:])
    return f"{drive.upper()}:\\{remainder}" if remainder else f"{drive.upper()}:\\"
