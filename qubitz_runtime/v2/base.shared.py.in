# <QUBITZ_SHARED_SYMBOL:base:8e4a1f9216238084> module/ClassDef:LlamaCppServerProcess:0
class LlamaCppServerProcess:
    def __init__(self, config: AgentConfig) -> None:
        self.config = config
        self.runtime_workspace = config_runtime_workspace(config)
        self.process: subprocess.Popen[str] | None = None
        self.base_url = normalize_base_url(config.server_url)
        self.model_path: Path | None = None
        self.log_path = self.runtime_workspace / ".cache" / "llama.cpp" / "llama-server.log"

    def resolve_model_path(self) -> Path:
        if self.model_path is None:
            self.model_path = resolve_gguf_model_path(
                self.runtime_workspace,
                self.config.model_path,
                self.config.selected_model_filename,
            )
        if self.model_path is None:
            raise RuntimeError(
                "No local GGUF model path was found. "
                f"Set {GGUF_MODEL_PATH_ENV_NAME} or pass --model-path, "
                f"or place {DEFAULT_GGUF_MODEL_FILENAME} under models/."
            )
        return self.model_path

    def resolve_executable(self) -> str:
        executable = resolve_llama_server_executable(self.runtime_workspace, self.config.llama_server_path)
        if executable is None:
            raise RuntimeError(
                "No llama-server executable was found. "
                f"Install llama.cpp or set {LLAMACPP_SERVER_PATH_ENV_NAME}."
            )
        return executable

    def _launch_command(self) -> list[str]:
        base_url = self.base_url
        if "://" in base_url:
            host_port = base_url.split("://", 1)[1]
        else:
            host_port = base_url
        host, _, port_text = host_port.partition(":")
        port = port_text or str(DEFAULT_LLAMACPP_PORT)
        executable = self.resolve_executable()
        model_path = self.resolve_model_path()
        command = [
            executable,
            "--model",
            str(model_path),
            "--alias",
            self.config.model_name,
            "--host",
            host or DEFAULT_LLAMACPP_HOST,
            "--port",
            port,
            "--ctx-size",
            str(self.config.num_ctx),
            "--parallel",
            str(DEFAULT_LLAMACPP_PARALLEL),
            "--jinja",
            "--flash-attn",
            "on",
            "--no-warmup",
            "--temp",
            str(self.config.temperature),
            "--top-p",
            str(self.config.top_p),
            "--min-p",
            str(self.config.min_p),
            "--repeat-penalty",
            str(self.config.repeat_penalty),
        ]
        chat_template = (os.environ.get(LLAMACPP_CHAT_TEMPLATE_ENV_NAME) or "").strip()
        chat_template_file = (os.environ.get(LLAMACPP_CHAT_TEMPLATE_FILE_ENV_NAME) or "").strip()
        if chat_template_file:
            command.extend(["--chat-template-file", chat_template_file])
        elif chat_template:
            command.extend(["--chat-template", chat_template])
        if in_wsl() and executable.lower().endswith(".exe") and shutil.which("powershell.exe"):
            windows_command = list(command)
            windows_command[0] = wsl_path_to_windows_path(executable)
            windows_command[2] = wsl_path_to_windows_path(model_path)
            if "--chat-template-file" in windows_command:
                index = windows_command.index("--chat-template-file")
                if index + 1 < len(windows_command):
                    windows_command[index + 1] = wsl_path_to_windows_path(windows_command[index + 1])
            workspace_windows = wsl_path_to_windows_path(self.runtime_workspace)
            script_lines = [
                "$ProgressPreference = 'SilentlyContinue'",
                f"Set-Location -LiteralPath {powershell_single_quote(workspace_windows)}",
                "& " + " ".join(powershell_single_quote(part) for part in windows_command),
            ]
            script = "\n".join(script_lines)
            return [
                "powershell.exe",
                "-NoProfile",
                "-EncodedCommand",
                base64.b64encode(script.encode("utf-16le")).decode("ascii"),
            ]
        return command

    def ensure_started(self) -> None:
        if self.process is not None and self.process.poll() is None:
            return
        creationflags = 0
        startupinfo: subprocess.STARTUPINFO | None = None
        if os.name == "nt":
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
        launch_command = self._launch_command()
        command_path = Path(launch_command[0])
        if launch_command[0].lower() == "powershell.exe" or command_path.suffix.lower() == ".exe":
            self.log_path = self.runtime_workspace / ".cache" / "llama.cpp" / "llama-server.log"
        else:
            self.log_path = llamacpp_native_server_log_path(self.runtime_workspace)
        self.log_path.parent.mkdir(parents=True, exist_ok=True)
        with self.log_path.open("w", encoding="utf-8", errors="ignore") as log_handle:
            log_handle.write(f"[{now_stamp()}] Starting llama-server\n")
            log_handle.write("Command: " + " ".join(launch_command) + "\n\n")
        log_handle = self.log_path.open("a", encoding="utf-8", errors="ignore")
        popen_command = launch_command
        if in_wsl() and popen_command and popen_command[0].lower() == "powershell.exe":
            self.process = subprocess.Popen(
                render_windows_command_for_wsl_shell(popen_command),
                cwd=self.runtime_workspace,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                text=True,
                shell=True,
                executable="/bin/bash",
                creationflags=creationflags,
                startupinfo=startupinfo,
            )
            return
        if in_wsl() and popen_command and (
            popen_command[0].lower().endswith(".exe") or Path(popen_command[0]).suffix.lower() == ".exe"
        ):
            popen_command = wrap_windows_command_for_wsl(popen_command)
        environment_overrides = getattr(self, "_qubitz_child_environment", None)
        launch_environment = {**os.environ, **environment_overrides} if environment_overrides else None
        self.process = subprocess.Popen(
            popen_command,
            cwd=self.runtime_workspace,
            env=launch_environment,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            text=True,
            creationflags=creationflags,
            startupinfo=startupinfo,
        )

    def read_log_tail(self, max_chars: int = 4000) -> str:
        if not self.log_path.exists():
            return ""
        text = self.log_path.read_text(encoding="utf-8", errors="ignore")
        return shorten(text, max_chars)

    def shutdown(self) -> None:
        process = self.process
        if process is None:
            return
        if process.poll() is None:
            try:
                process.terminate()
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=getattr(self, "_qubitz_shutdown_grace_seconds", 10))
            except subprocess.TimeoutExpired:
                if process.poll() is None:
                    try:
                        process.kill()
                    except ProcessLookupError:
                        pass
                process.wait(timeout=getattr(self, "_qubitz_shutdown_kill_wait_seconds", 10))
        else:
            process.wait(timeout=0)
        self.process = None
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:9057cb886235fc8e> module/FunctionDef:load_harness_text:0
def load_harness_text(workspace: Path) -> str:
    encrypted_path = workspace / DEFAULT_ENCRYPTED_HARNESS_NAME
    plaintext_path = workspace / DEFAULT_HARNESS_NAME
    plaintext_text = plaintext_path.read_text(encoding="utf-8", errors="ignore") if plaintext_path.exists() else None
    if encrypted_path.exists():
        try:
            encrypted_text = decrypt_harness_bytes(encrypted_path.read_bytes(), workspace)
        except Exception:
            if plaintext_text is not None:
                try:
                    _sync_encrypted_harness_from_plaintext(workspace, plaintext_text)
                except Exception:
                    pass
                return plaintext_text
            raise
        if plaintext_text is not None and plaintext_text != encrypted_text:
            try:
                _sync_encrypted_harness_from_plaintext(workspace, plaintext_text)
            except Exception:
                pass
            return plaintext_text
        return encrypted_text
    if plaintext_text is not None:
        return plaintext_text
    raise FileNotFoundError(
        f"Missing harness file. Expected {DEFAULT_ENCRYPTED_HARNESS_NAME} or {DEFAULT_HARNESS_NAME} in {workspace}."
    )
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:905c29e1373e3b2a> module/ClassDef:QubitzGUI:0
class QubitzGUI:
    def __init__(self, config: AgentConfig) -> None:
        tk, ttk, scrolledtext, messagebox, filedialog = import_tk_modules()
        self.tk = tk
        self.ttk = ttk
        self.scrolledtext = scrolledtext
        self.messagebox = messagebox
        self.filedialog = filedialog
        self.config = config
        self.agent = AgentRunner(config)
        self.root = tk.Tk()
        self.root.title("AI Agent Qubitz")
        self.root.geometry("800x800")
        self.root.minsize(800, 800)
        self.root.protocol("WM_DELETE_WINDOW", self._handle_close)
        self.root.configure(bg=UI_BG, bd=0, highlightthickness=0)
        self._apply_theme()
        self.status_var = tk.StringVar(master=self.root, value="Ready")
        self.num_ctx_var = tk.StringVar(master=self.root, value=str(self.config.num_ctx))
        self.num_predict_var = tk.StringVar(master=self.root, value=str(self.config.num_predict))
        self.event_queue: queue.Queue[tuple[str, str]] = queue.Queue()
        self.busy = False
        self.cancel_requested = False
        self.pending_prompts: list[str] = []
        self._build_layout()
        self.root.bind("<Escape>", self._handle_cancel_shortcut)
        self.root.bind_all("<Control-c>", self._handle_copy_shortcut, add="+")
        self.root.bind_all("<Control-C>", self._handle_copy_shortcut, add="+")
        self.root.after_idle(self._present_window)
        self._append_transcript("system", f"Workspace: {config.workspace.as_posix()}")
        self._append_transcript("system", f"Model alias: {config.model_name}")
        self._append_transcript("system", f"GGUF model: {DEFAULT_GGUF_MODEL_LABEL} ({config.selected_model_filename})")
        self._append_transcript("system", f"Embedding Model: {config.embed_model_name}")
        self._append_transcript(
            "system",
            f"Runtime defaults: num_ctx={config.num_ctx}, num_predict={config.num_predict}.",
        )
        self._append_transcript(
            "system",
            "The agent uses a local llama.cpp GGUF backend plus retrieval, FAISS, and local tools for reading, editing, deleting, installing, and running bounded commands.",
        )
        self._append_transcript("system", f"Local skills discovered: {self.agent.skills.count()}")
        for warning in self.agent.skills.warnings:
            self._append_transcript("status", f"Skill warning: {warning}")
        self.root.after(100, self._poll_events)

    def _apply_theme(self) -> None:
        self.root.configure(bg=UI_BG)
        self.root.option_add("*Background", UI_BG)
        self.root.option_add("*Foreground", UI_TEXT)
        self.root.option_add("*selectBackground", UI_SELECT)
        self.root.option_add("*selectForeground", UI_TEXT)
        style = self.ttk.Style(self.root)
        style.theme_use("clam")
        style.configure(".", background=UI_BG, foreground=UI_TEXT)
        style.configure("TFrame", background=UI_BG)
        style.configure("TLabel", background=UI_BG, foreground=UI_TEXT)
        style.configure(
            "TEntry",
            fieldbackground=UI_PANEL,
            foreground=UI_TEXT,
            bordercolor=UI_BORDER,
            lightcolor=UI_PANEL,
            darkcolor=UI_PANEL,
            insertcolor=UI_TEXT,
            padding=(6, 6),
        )
        style.map(
            "TEntry",
            fieldbackground=[("disabled", UI_PANEL), ("readonly", UI_PANEL)],
            foreground=[("disabled", UI_TEXT_MUTED)],
        )
        style.configure(
            "TButton",
            background=UI_PANEL_ALT,
            foreground=UI_TEXT,
            bordercolor=UI_BORDER,
            lightcolor=UI_PANEL_ALT,
            darkcolor=UI_PANEL_ALT,
            focuscolor=UI_PANEL_ALT,
            padding=(10, 8),
        )
        style.map(
            "TButton",
            background=[("active", UI_SELECT), ("pressed", UI_SELECT), ("disabled", UI_PANEL)],
            foreground=[("disabled", UI_TEXT_MUTED)],
        )

    def _maximize_window(self) -> None:
        if in_wsl():
            self._fit_window_to_screen()
            return
        try:
            self.root.state("zoomed")
            return
        except self.tk.TclError:
            pass
        try:
            self.root.wm_attributes("-zoomed", True)
            return
        except self.tk.TclError:
            pass
        self.root.update_idletasks()
        width = max(800, self.root.winfo_screenwidth())
        height = max(800, self.root.winfo_screenheight())
        self.root.geometry(f"{width}x{height}+0+0")

    def _fit_window_to_screen(self) -> None:
        self.root.update_idletasks()
        screen_width = max(800, self.root.winfo_screenwidth())
        screen_height = max(800, self.root.winfo_screenheight())
        width = min(max(1100, screen_width - 120), screen_width)
        height = min(max(800, screen_height - 120), screen_height)
        x = max(0, (screen_width - width) // 2)
        y = max(0, (screen_height - height) // 2)
        try:
            self.root.state("normal")
        except self.tk.TclError:
            pass
        self.root.geometry(f"{width}x{height}+{x}+{y}")

    def _present_window(self) -> None:
        try:
            self.root.deiconify()
        except self.tk.TclError:
            pass
        self._maximize_window()
        self.root.update_idletasks()
        try:
            self.root.lift()
        except self.tk.TclError:
            pass
        try:
            self.root.attributes("-topmost", True)
            self.root.after(250, lambda: self.root.attributes("-topmost", False))
        except self.tk.TclError:
            pass
        try:
            self.root.focus_force()
        except self.tk.TclError:
            pass
        self.root.after(500, self._ensure_window_visible)
        self.root.after(1500, self._ensure_window_visible)

    def _ensure_window_visible(self) -> None:
        self.root.update_idletasks()
        try:
            x = self.root.winfo_x()
            y = self.root.winfo_y()
            width = max(1, self.root.winfo_width())
            height = max(1, self.root.winfo_height())
            screen_width = max(800, self.root.winfo_screenwidth())
            screen_height = max(800, self.root.winfo_screenheight())
        except self.tk.TclError:
            return
        if (
            x < 0
            or y < 0
            or width <= 1
            or height <= 1
            or x >= screen_width
            or y >= screen_height
            or x + min(width, 120) > screen_width
            or y + min(height, 120) > screen_height
        ):
            try:
                self._fit_window_to_screen()
                self.root.lift()
            except self.tk.TclError:
                pass

    def _build_layout(self) -> None:
        frame = self.ttk.Frame(self.root, padding=10)
        frame.pack(fill="both", expand=True)

        header = self.ttk.Frame(frame)
        header.pack(fill="x", pady=(0, 10))
        title = self.ttk.Label(header, text="AI Agent Qubitz", font=("TkDefaultFont", 14, "bold"))
        title.pack(side="left")
        header_actions = self.ttk.Frame(header)
        header_actions.pack(side="right")
        self.change_workspace_button = self.ttk.Button(
            header_actions,
            text="Change Workspace",
            command=self._change_workspace,
        )
        self.change_workspace_button.pack(side="left", padx=(0, 10))
        self.ttk.Label(header_actions, textvariable=self.status_var).pack(side="left")

        controls = self.ttk.Frame(frame)
        controls.pack(fill="x", pady=(0, 10))
        self.ttk.Label(controls, text=f"GGUF {DEFAULT_GGUF_MODEL_LABEL}").pack(side="left")
        self.ttk.Label(controls, text="Context").pack(side="left")
        self.num_ctx_entry = self.ttk.Entry(controls, textvariable=self.num_ctx_var, width=10)
        self.num_ctx_entry.pack(side="left", padx=(6, 16))
        self.ttk.Label(controls, text="Max Output").pack(side="left")
        self.num_predict_entry = self.ttk.Entry(controls, textvariable=self.num_predict_var, width=10)
        self.num_predict_entry.pack(side="left", padx=(6, 0))

        self.transcript = self.scrolledtext.ScrolledText(frame, wrap="word", state="disabled", height=30)
        self.transcript.configure(
            background=UI_PANEL,
            foreground=UI_TEXT,
            insertbackground=UI_TEXT,
            selectbackground=UI_SELECT,
            selectforeground=UI_TEXT,
            highlightbackground=UI_BORDER,
            highlightcolor=UI_BORDER,
            highlightthickness=1,
            borderwidth=0,
            relief="flat",
        )
        self.transcript.vbar.configure(
            background=UI_PANEL_ALT,
            troughcolor=UI_BG,
            activebackground=UI_SELECT,
            highlightbackground=UI_BG,
        )
        self.transcript.pack(fill="both", expand=True)
        self.transcript.bind("<Control-c>", self._handle_copy_shortcut)
        self.transcript.bind("<Control-C>", self._handle_copy_shortcut)

        composer = self.ttk.Frame(frame)
        composer.pack(fill="both", pady=(10, 0))
        self.prompt_box = self.tk.Text(composer, wrap="word", height=8)
        self.prompt_box.configure(
            background=UI_PANEL,
            foreground=UI_TEXT,
            insertbackground=UI_TEXT,
            selectbackground=UI_SELECT,
            selectforeground=UI_TEXT,
            highlightbackground=UI_BORDER,
            highlightcolor=UI_BORDER,
            highlightthickness=1,
            borderwidth=0,
            relief="flat",
        )
        self.prompt_box.pack(fill="both", expand=True, side="left")
        self.prompt_box.bind("<Return>", self._handle_send_shortcut)
        self.prompt_box.bind("<Shift-Return>", self._handle_newline_shortcut)
        self.prompt_box.bind("<Escape>", self._handle_cancel_shortcut)
        self.prompt_box.bind("<Control-c>", self._handle_copy_shortcut)
        self.prompt_box.bind("<Control-C>", self._handle_copy_shortcut)

        buttons = self.ttk.Frame(composer)
        buttons.pack(fill="y", side="left", padx=(10, 0))
        self.send_button = self.ttk.Button(buttons, text="Send", command=self.send_prompt)
        self.send_button.pack(fill="x")
        self.clear_button = self.ttk.Button(buttons, text="Clear", command=self.clear_input)
        self.clear_button.pack(fill="x", pady=(8, 0))

    def _append_transcript(self, role: str, message: str) -> None:
        self.transcript.configure(state="normal")
        self.transcript.insert("end", f"[{role}] {message.strip()}\n\n")
        self.transcript.configure(state="disabled")
        self.transcript.see("end")

    def _set_busy(self, value: bool) -> None:
        self.busy = value
        self.cancel_requested = False
        self._update_send_button()
        self.clear_button.configure(state="normal")
        self.change_workspace_button.configure(state="disabled" if value else "normal")
        self.prompt_box.configure(state="normal")
        settings_state = "disabled" if value else "normal"
        self.num_ctx_entry.configure(state=settings_state)
        self.num_predict_entry.configure(state=settings_state)
        self.status_var.set("Working (Esc to cancel)" if value else "Ready")

    def _update_send_button(self) -> None:
        if self.busy:
            label = f"Queue ({len(self.pending_prompts)})" if self.pending_prompts else "Queue"
        else:
            label = "Send"
        self.send_button.configure(text=label, state="normal")

    def _sync_runtime_settings(self) -> None:
        try:
            num_ctx = int(self.num_ctx_var.get().strip())
            num_predict = int(self.num_predict_var.get().strip())
        except ValueError as exc:
            raise ValueError("Context and Max Output must be integers.") from exc
        if num_ctx <= 0 or num_predict <= 0:
            raise ValueError("Context and Max Output must be positive integers.")
        self.config.num_ctx = num_ctx
        self.config.num_predict = num_predict

    def clear_input(self) -> None:
        self.prompt_box.delete("1.0", "end")

    def _change_workspace(self) -> None:
        if self.busy:
            self.messagebox.showinfo(
                "AI Agent Qubitz",
                "Wait for the current task to finish or cancel it before changing the workspace.",
            )
            return
        selected = pick_workspace_directory(self.config.workspace, self.filedialog, parent=self.root)
        if selected is None:
            return
        workspace = selected.resolve()
        if not workspace.exists():
            self.messagebox.showerror("AI Agent Qubitz", f"Selected workspace does not exist:\n{workspace}")
            return
        if not workspace.is_dir():
            self.messagebox.showerror("AI Agent Qubitz", f"Selected path is not a directory:\n{workspace}")
            return
        if workspace == self.config.workspace.resolve():
            self._append_transcript("status", "Workspace unchanged.")
            self.prompt_box.focus_set()
            return
        self.status_var.set("Switching workspace")
        candidate_config = replace(
            self.config,
            workspace=workspace,
            runtime_workspace=self.agent.runtime_workspace,
        )
        try:
            new_agent = AgentRunner(candidate_config)
        except Exception as exc:
            self.status_var.set("Ready")
            self.messagebox.showerror(
                "AI Agent Qubitz",
                f"Failed to switch workspace to:\n{workspace}\n\n{exc}",
            )
            return
        configure_project_environment(new_agent.runtime_workspace)
        try:
            self.agent.reset_runtime()
        except Exception as exc:
            self._append_transcript("status", f"Workspace switch warning: failed to reset the old runtime: {exc}")
        self.config = candidate_config
        self.agent = new_agent
        self.pending_prompts.clear()
        self.cancel_requested = False
        self._update_send_button()
        self.status_var.set("Ready")
        self._append_transcript("status", f"Workspace changed to {workspace.as_posix()}")
        self._append_transcript("system", f"Workspace: {workspace.as_posix()}")
        self._append_transcript("system", f"Local skills discovered: {self.agent.skills.count()}")
        for warning in self.agent.skills.warnings:
            self._append_transcript("status", f"Skill warning: {warning}")
        self.prompt_box.focus_set()

    def _handle_close(self) -> None:
        self.agent.reset_runtime()
        self.root.destroy()

    def _handle_send_shortcut(self, _event: Any) -> str:
        self.send_prompt()
        return "break"

    def _handle_copy_shortcut(self, event: Any) -> str | None:
        def _selected_text(widget: Any) -> str:
            try:
                return widget.get("sel.first", "sel.last")
            except Exception:
                pass
            try:
                if hasattr(widget, "selection_present") and not widget.selection_present():
                    return ""
                return widget.selection_get()
            except Exception:
                return ""

        candidates: list[Any] = []
        widget = getattr(event, "widget", None)
        if widget is not None:
            candidates.append(widget)
        try:
            focused = self.root.focus_get()
        except Exception:
            focused = None
        if focused is not None and focused not in candidates:
            candidates.append(focused)
        selected_text = ""
        for candidate in candidates:
            selected_text = _selected_text(candidate)
            if selected_text:
                break
        if not selected_text:
            try:
                selected_text = self.root.selection_get()
            except Exception:
                return None
        if not selected_text:
            return None
        self.root.clipboard_clear()
        self.root.clipboard_append(selected_text)
        self.root.update_idletasks()
        return "break"

    def _handle_newline_shortcut(self, _event: Any) -> str:
        self.prompt_box.insert("insert", "\n")
        return "break"

    def _handle_cancel_shortcut(self, _event: Any) -> str:
        self._request_cancel()
        return "break"

    def _request_cancel(self) -> None:
        if not self.busy or self.cancel_requested:
            return
        self.cancel_requested = True
        self.status_var.set("Cancelling")
        self.agent.request_cancel()

    def _start_prompt(self, prompt: str, *, queued: bool = False) -> None:
        if queued:
            remaining = len(self.pending_prompts)
            remaining_text = f"{remaining} more queued after this." if remaining else "Queue will be empty after this task."
            self._append_transcript("status", f"Starting queued task. {remaining_text}")
        self._append_transcript("user", prompt)
        self._set_busy(True)
        worker = threading.Thread(target=self._worker_run, args=(prompt,), daemon=True)
        worker.start()

    def send_prompt(self) -> None:
        raw_prompt = self.prompt_box.get("1.0", "end").strip()
        if not raw_prompt:
            return
        is_side_note = raw_prompt.lower() == "/btw" or raw_prompt.lower().startswith("/btw ")
        prompt = raw_prompt[4:].strip() if is_side_note else raw_prompt
        if not prompt:
            return
        if self.busy and is_side_note:
            self.prompt_box.delete("1.0", "end")
            if self.agent.submit_side_note(prompt):
                self._append_transcript("btw", prompt)
                self._append_transcript("status", "Attached /btw update to the active task.")
                return
        if not self.busy:
            try:
                self._sync_runtime_settings()
            except ValueError as exc:
                self.messagebox.showerror("AI Agent Qubitz", str(exc))
                return
        self.prompt_box.delete("1.0", "end")
        if self.busy:
            self.pending_prompts.append(prompt)
            self._append_transcript("queued", raw_prompt)
            self._append_transcript("status", f"Queued task to run next ({len(self.pending_prompts)} waiting).")
            self._update_send_button()
            return
        self._start_prompt(prompt)

    def _worker_emit(self, kind: str, message: str) -> None:
        self.event_queue.put((kind, message))

    def _worker_run(self, prompt: str) -> None:
        try:
            answer = self.agent.run_sync(prompt, self._worker_emit)
        except Exception as exc:  # pragma: no cover - runtime GUI path
            details = "".join(traceback.format_exception(exc))
            self.event_queue.put(("error", details))
        else:
            self.event_queue.put(("answer", answer))
        finally:
            self.event_queue.put(("done", ""))

    def _poll_events(self) -> None:
        while True:
            try:
                kind, message = self.event_queue.get_nowait()
            except queue.Empty:
                break
            if kind == "status":
                self.status_var.set(message)
                self._append_transcript("status", message)
            elif kind == "tool":
                self._append_transcript("tool", message)
            elif kind == "answer":
                self._append_transcript("assistant", message)
            elif kind == "error":
                self._append_transcript("error", message)
                self.messagebox.showerror("AI Agent Qubitz", message)
            elif kind == "done":
                self._set_busy(False)
                if self.pending_prompts:
                    next_prompt = self.pending_prompts.pop(0)
                    self._update_send_button()
                    self._start_prompt(next_prompt, queued=True)
        self.root.after(100, self._poll_events)

    def run(self) -> None:
        self.root.mainloop()
