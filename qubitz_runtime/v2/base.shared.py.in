FILE_TOKEN_PATTERN = re.compile(
    r"`([^`]+)`|\"([^\"]+)\"|'([^']+)'|(?<!\w)([A-Za-z]:[A-Za-z0-9_ .\-\\/]+(?:\.[A-Za-z0-9_]+)|[A-Za-z0-9_.\-\\/]+(?:\.[A-Za-z0-9_]+))(?!\w)"
