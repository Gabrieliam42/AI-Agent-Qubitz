# <QUBITZ_SHARED_SYMBOL:base:83fd0dffcb26bad2> module/FunctionDef:is_excluded_dir_name:0
def is_excluded_dir_name(name: str, excluded_dirs: set[str] | None = None) -> bool:
    normalized = name.strip().lower()
    if not normalized:
        return False
    if excluded_dirs is not None and normalized in excluded_dirs:
        return True
    return bool(VENV_DIR_PATTERN.fullmatch(normalized))
