# <QUBITZ_SHARED_SYMBOL:base:091f46c0adb55c1f> module/FunctionDef:ensure_project_local_native_llamacpp_runtime:0
def ensure_project_local_native_llamacpp_runtime(workspace: Path) -> dict[str, Any]:
    if not in_wsl():
        raise RuntimeError("Native WSL llama.cpp bootstrap is only available inside WSL.")
    executable = llamacpp_native_server_executable(workspace)
    build_log = llamacpp_native_build_log_path(workspace)
    if executable.exists():
        return {
            "executable": executable.resolve(),
            "built": False,
            "release_tag": None,
            "runtime_dir": llamacpp_native_runtime_dir(workspace).resolve(),
            "build_log": build_log.resolve(),
        }
    if os.environ.get("QUBITZ_OFFLINE") == "1":
        raise RuntimeError("Native WSL llama.cpp build requires online source download, but QUBITZ_OFFLINE=1.")
    build_tools = ensure_wsl_native_build_tools(workspace)
    for required in ("gcc", "g++", "nvcc", "git"):
        if shutil.which(required) is None:
            raise RuntimeError(f"Required WSL build tool is missing: {required}")
    release = fetch_latest_llamacpp_release()
    release_tag = str(release.get("tag_name") or "").strip() or "latest"
    downloads_dir = workspace / ".cache" / "downloads" / "llama.cpp" / release_tag
    tarball = downloads_dir / f"llama.cpp-{release_tag}.tar.gz"
    if not tarball.exists():
        download_url_to_path(
            f"https://github.com/ggml-org/llama.cpp/archive/refs/tags/{release_tag}.tar.gz",
            tarball,
        )
    tmp_root = workspace / ".cache" / "tmp" / f"llama.cpp-src-{release_tag}"
    extract_tar_to_dir(tarball, tmp_root)
    extracted_dirs = [item for item in tmp_root.iterdir() if item.is_dir()]
    if not extracted_dirs:
        raise RuntimeError(f"Failed to extract llama.cpp source archive for {release_tag}.")
    source_dir = llamacpp_native_source_dir(workspace, release_tag)
    if source_dir.exists():
        shutil.rmtree(source_dir)
    shutil.move(str(extracted_dirs[0]), str(source_dir))
    shutil.rmtree(tmp_root, ignore_errors=True)
    runtime_dir = llamacpp_native_runtime_dir(workspace)
    build_dir = llamacpp_native_build_dir(workspace)
    runtime_dir.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    path_entries = [
        str(build_tools["cmake"].parent),
        str(build_tools["ninja"].parent),
        env.get("PATH", ""),
    ]
    env["PATH"] = os.pathsep.join(entry for entry in path_entries if entry)
    configure_cmd = [
        str(build_tools["cmake"]),
        "-S",
        str(source_dir),
        "-B",
        str(build_dir),
        "-G",
        "Ninja",
        "-DGGML_CUDA=ON",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DGGML_NATIVE=ON",
        f"-DCMAKE_CUDA_ARCHITECTURES={WSL_LLAMACPP_NATIVE_ARCH}",
    ]
    build_cmd = [
        str(build_tools["cmake"]),
        "--build",
        str(build_dir),
        "--config",
        "Release",
        "--target",
        "llama-server",
        "-j",
        "8",
    ]
    with build_log.open("w", encoding="utf-8", errors="ignore") as handle:
        handle.write(f"[{now_stamp()}] Building native WSL llama.cpp runtime\n")
        handle.write("Configure: " + " ".join(configure_cmd) + "\n")
        handle.write("Build: " + " ".join(build_cmd) + "\n\n")
        configure = subprocess.run(
            configure_cmd,
            cwd=workspace,
            env=env,
            stdout=handle,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=1800,
            check=False,
        )
        if configure.returncode != 0:
            raise RuntimeError(
                "Failed to configure native WSL llama.cpp build. Build log tail:\n"
                + shorten(build_log.read_text(encoding="utf-8", errors="ignore"), 4000)
            )
        build = subprocess.run(
            build_cmd,
            cwd=workspace,
            env=env,
            stdout=handle,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=7200,
            check=False,
        )
    if build.returncode != 0 or not executable.exists():
        raise RuntimeError(
            "Failed to build native WSL llama.cpp runtime. Build log tail:\n"
            + shorten(build_log.read_text(encoding="utf-8", errors="ignore"), 4000)
        )
    return {
        "executable": executable.resolve(),
        "built": True,
        "release_tag": release_tag,
        "runtime_dir": runtime_dir.resolve(),
        "build_log": build_log.resolve(),
        "source_dir": source_dir.resolve(),
    }
