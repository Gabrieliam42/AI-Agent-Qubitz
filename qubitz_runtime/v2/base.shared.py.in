# <QUBITZ_SHARED_SYMBOL:base:d79d63e93cc4df61> module/ClassDef:WindowsBridgeHTTPTransport:0
class WindowsBridgeHTTPTransport:
    def __init__(self, base_url: str = DEFAULT_LLAMACPP_BASE_URL) -> None:
        self.base_url = base_url.rstrip("/")
        self.label = "windows-bridge"

    @staticmethod
    def _encoded(script: str) -> str:
        return base64.b64encode(script.encode("utf-16le")).decode("ascii")

    def _run_script(self, script: str) -> str:
        script = "$ErrorActionPreference = 'Stop'\n" + script
        # Keep chat payloads off both the Linux and Windows command lines.
        bootstrap = (
            "$ErrorActionPreference = 'Stop'\n"
            "[Console]::InputEncoding = New-Object System.Text.UTF8Encoding($false)\n"
            "[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false)\n"
            "& ([ScriptBlock]::Create([Console]::In.ReadToEnd()))"
        )
        result = subprocess.run(
            ["powershell.exe", "-NoProfile", "-NonInteractive", "-EncodedCommand", self._encoded(bootstrap)],
            input=script,
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=600,
            check=False,
        )
        if result.returncode != 0:
            message = result.stderr.strip() or result.stdout.strip() or "Unknown PowerShell error"
            raise RuntimeError(message)
        return result.stdout.strip()

    def _decode_response(self, output: str, path: str) -> dict[str, Any]:
        try:
            payload = json.loads(output)
        except ValueError as exc:
            raise RuntimeError(f"Windows HTTP bridge returned no valid JSON for {path}.") from exc
        if not isinstance(payload, dict):
            raise RuntimeError(f"Windows HTTP bridge returned a non-object response for {path}.")
        return payload

    def probe_json(self, path: str, timeout: float = 20.0) -> dict[str, Any]:
        script = textwrap.dedent(
            f"""
            $ProgressPreference = 'SilentlyContinue'
            try {{
                $response = Invoke-WebRequest -UseBasicParsing -Uri '{self.base_url}{path}' -Method Get -TimeoutSec {max(1, int(timeout))}
                $status = [int]$response.StatusCode
                $text = [string]$response.Content
            }} catch {{
                $response = $_.Exception.Response
                if ($null -eq $response) {{ throw }}
                $status = [int]$response.StatusCode
                $text = [string]$_.ErrorDetails.Message
                if (-not $text) {{
                    $reader = New-Object System.IO.StreamReader($response.GetResponseStream())
                    try {{ $text = $reader.ReadToEnd() }} finally {{ $reader.Dispose() }}
                }}
            }}
            @{{status_code = $status; text = $text}} | ConvertTo-Json -Depth 100 -Compress
            """
        )
        envelope = self._decode_response(self._run_script(script), path)
        text = str(envelope.get("text") or "")
        try:
            payload = json.loads(text)
        except ValueError:
            payload = {}
        return {"status_code": int(envelope.get("status_code") or 0),
                "json": payload if isinstance(payload, dict) else {}, "text": text}

    def get_json(self, path: str) -> dict[str, Any]:
        probe = self.probe_json(path)
        status = int(probe["status_code"])
        if not 200 <= status < 300:
            raise RuntimeError(f"HTTP {status} for {self.base_url}{path}: {probe['text'][:300]}")
        return probe["json"]

    def post_json(self, path: str, payload: dict[str, Any]) -> dict[str, Any]:
        body = json.dumps(payload, ensure_ascii=True)
        script = textwrap.dedent(
            f"""
            $ProgressPreference = 'SilentlyContinue'
            $body = @'
            {body}
            '@
            $response = Invoke-RestMethod -Uri '{self.base_url}{path}' -Method Post -ContentType 'application/json' -Body $body
            $response | ConvertTo-Json -Depth 100 -Compress
            """
        )
        output = self._run_script(script)
        return self._decode_response(output, path)
