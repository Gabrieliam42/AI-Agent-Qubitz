# <QUBITZ_SHARED_SYMBOL:base:322e88641c19934e> module/FunctionDef:pick_workspace_directory:0
def pick_workspace_directory(current_workspace: Path, filedialog: Any, parent: Any | None = None) -> Path | None:
    if parent is not None:
        try:
            parent.update_idletasks()
            parent.lift()
            parent.focus_force()
        except Exception:
            pass
    if in_wsl():
        powershell = shutil.which("powershell.exe")
        if powershell:
            script_lines = [
                "Add-Type -AssemblyName System.Windows.Forms",
                "Add-Type -AssemblyName System.Drawing",
                "$owner = New-Object System.Windows.Forms.Form",
                "$owner.StartPosition = [System.Windows.Forms.FormStartPosition]::Manual",
                "$owner.Location = New-Object System.Drawing.Point(-32000, -32000)",
                "$owner.Size = New-Object System.Drawing.Size(1, 1)",
                "$owner.ShowInTaskbar = $false",
                "$owner.TopMost = $true",
                "$owner.Opacity = 0",
                "[void]$owner.Show()",
                "$owner.Activate()",
                "$dialog = New-Object System.Windows.Forms.FolderBrowserDialog",
                "$dialog.Description = 'Select the workspace directory'",
                "$dialog.ShowNewFolderButton = $true",
            ]
            initial_windows_path = wsl_path_to_windows(current_workspace)
            if initial_windows_path:
                escaped = initial_windows_path.replace("'", "''")
                script_lines.append(f"$dialog.SelectedPath = '{escaped}'")
            script_lines.extend(
                [
                    "$result = $dialog.ShowDialog($owner)",
                    "$owner.Close()",
                    "$owner.Dispose()",
                    "if ($result -eq [System.Windows.Forms.DialogResult]::OK) { [Console]::Out.Write($dialog.SelectedPath) }",
                ]
            )
            completed = subprocess.run(
                [powershell, "-NoProfile", "-STA", "-Command", "; ".join(script_lines)],
                capture_output=True,
                text=True,
                check=False,
            )
            selected = completed.stdout.strip()
            if completed.returncode == 0 and selected:
                return normalize_workspace_directory(selected).resolve()
    initial_directory = current_workspace.as_posix() if in_wsl() else str(current_workspace)
    dialog_kwargs: dict[str, Any] = {"initialdir": initial_directory, "mustexist": True}
    if parent is not None:
        dialog_kwargs["parent"] = parent
    selected = filedialog.askdirectory(**dialog_kwargs)
    if not selected:
        return None
    return normalize_workspace_directory(selected).resolve()
