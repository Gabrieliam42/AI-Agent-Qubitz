# <QUBITZ_SHARED_SYMBOL:base:4730b9962a109078> module/ClassDef:AgentRunner:0
class AgentRunner:
    def __init__(self, config: AgentConfig) -> None:
        self.config = config
        self.workspace = config.workspace.resolve()
        self.runtime_workspace = config_runtime_workspace(config)
        self.memory = MemoryStore(self.runtime_workspace)
        self.skills = SkillRegistry(self.runtime_workspace)
        self.retriever = RepoRetriever(config, progress_callback=self._report_retrieval)
        self.history: list[dict[str, str]] = []
        self.history_summary = ""
        self.harness_text = load_harness_text(self.runtime_workspace)
        self._active_callback: Callable[[str, str], None] | None = None
        self._llm: LlamaCppClient | None = None
        self._validated_model_keys: set[tuple[str, str]] = set()
        self._startup_diagnostics_cache: dict[tuple[str, str], dict[str, Any]] = {}
        self._tool_definitions_cache: list[dict[str, Any]] | None = None
        self._tool_count_cache = 0
        self._cancel_event = threading.Event()
        self._side_notes_lock = threading.Lock()
        self._pending_side_notes: list[str] = []

    def _emit(self, callback: Callable[[str, str], None] | None, kind: str, message: str) -> None:
        if callback is not None:
            callback(kind, message)

    def request_cancel(self) -> None:
        if self._cancel_event.is_set():
            return
        self._cancel_event.set()
        self._emit(
            self._active_callback,
            "status",
            "Cancellation requested. Waiting for the current model or tool step to finish.",
        )

    def _raise_if_cancelled(self) -> None:
        if self._cancel_event.is_set():
            raise RunCancelled()

    def submit_side_note(self, note: str) -> bool:
        cleaned = note.strip()
        if not cleaned:
            return False
        callback = self._active_callback
        if callback is None:
            return False
        with self._side_notes_lock:
            self._pending_side_notes.append(cleaned)
        self._emit(
            callback,
            "status",
            "Received /btw note. It will steer the active task after the current step finishes.",
        )
        return True

    def _drain_side_notes(self) -> list[str]:
        with self._side_notes_lock:
            notes = list(self._pending_side_notes)
            self._pending_side_notes.clear()
        return notes

    def _apply_side_notes(
        self,
        messages: list[dict[str, Any]],
        callback: Callable[[str, str], None] | None,
        *,
        assistant_content: str | None = None,
    ) -> bool:
        notes = self._drain_side_notes()
        if not notes:
            return False
        if assistant_content:
            messages.append({"role": "assistant", "content": assistant_content})
        for note in notes:
            user_note = f"/btw {note}"
            self.memory.add_turn("user", user_note)
            self.history.append({"role": "user", "content": user_note})
        note_lines = "\n".join(f"- {note}" for note in notes)
        messages.append(
            {
                "role": "user",
                "content": (
                    "Additional user /btw updates for the current task:\n"
                    f"{note_lines}\n\n"
                    "Apply these updates to the active task before continuing."
                ),
            }
        )
        count = len(notes)
        suffix = "s" if count != 1 else ""
        self._emit(callback, "status", f"Applied {count} /btw update{suffix} to the active task.")
        return True

    def _get_llm(self) -> LlamaCppClient:
        if self._llm is None:
            self._llm = LlamaCppClient.detect(self.config)
        return self._llm

    def reset_runtime(self) -> None:
        if self._llm is not None:
            self._llm.shutdown()
        self._llm = None
        self._validated_model_keys.clear()
        self._startup_diagnostics_cache.clear()

    def _report_retrieval(self, message: str) -> None:
        self._emit(self._active_callback, "status", message)

    def _system_prompt(
        self,
        memory_context: str,
        active_skill_context: str = "",
        history_summary: str = "",
    ) -> str:
        history_section = history_summary or "None"
        skill_section = active_skill_context or "None"
        return textwrap.dedent(
            f"""
            You are AI Agent Qubitz, a local standalone coding agent running inside the repository workspace.

            Governing harness:
            {self.harness_text}

            Operating rules for this runtime:
            - Use tools directly whenever file inspection, file edits, file deletion, package installation, or command execution is needed.
            - Prefer relative workspace paths when possible.
            - Use the available tools to read current files before changing them.
            - When the user explicitly asks to read a named file, call read_file yourself instead of assuming the runtime already loaded it.
            - Keep final answers concise and factual.
            - Do not expose hidden chain-of-thought.
            - The current memory context is below.

            Memory context:
            {memory_context}

            Active local skills:
            {skill_section}

            Condensed earlier conversation summary:
            {history_section}
            """
        ).strip()

    def _compact_history(self) -> None:
        max_recent_messages = HISTORY_TURNS * 2
        if len(self.history) <= max_recent_messages:
            return
        overflow = self.history[:-max_recent_messages]
        self.history = self.history[-max_recent_messages:]
        lines = [self.history_summary.strip()] if self.history_summary.strip() else []
        for item in overflow:
            label = "User" if item.get("role") == "user" else "Assistant"
            lines.append(f"- {label}: {shorten(item.get('content', ''), 240)}")
        self.history_summary = shorten("\n".join(line for line in lines if line), MAX_HISTORY_SUMMARY_CHARS)

    def _estimate_active_context(
        self,
        messages: Sequence[dict[str, Any]],
        tool_definitions: Sequence[dict[str, Any]],
    ) -> int:
        payload = json.dumps({"messages": list(messages), "tools": list(tool_definitions)}, ensure_ascii=False)
        return estimate_tokens(payload)

    def _user_message(
        self,
        prompt: str,
        repo_context: str,
        active_skills: Sequence[SkillDefinition] | None = None,
    ) -> str:
        skill_list = ", ".join(skill.name for skill in active_skills or []) or "None"
        return textwrap.dedent(
            f"""
            User request:
            {prompt}

            Retrieved repository context:
            {repo_context}

            Activated skills:
            {skill_list}

            Use tools when they are helpful. Finish with a direct answer when the task is complete.
            """
        ).strip()

    def _adaptive_step_budget(self, prompt: str) -> tuple[int, list[str]]:
        if self.config.max_steps <= 0:
            return 0, ["unlimited mode"]
        base_steps = max(1, self.config.max_steps)
        if base_steps >= MAX_ADAPTIVE_TOOL_STEPS:
            return base_steps, []
        file_mentions = len(extract_file_tokens(prompt))
        multiline_request = len(prompt.splitlines()) >= 8
        long_request = len(prompt) >= 600
        reasons: list[str] = []
        complexity = 0
        if file_mentions >= 3:
            complexity += 3
            reasons.append("multiple file references")
        elif file_mentions >= 2:
            complexity += 2
            reasons.append("more than one file reference")
        if EDIT_INTENT_PATTERN.search(prompt):
            complexity += 3
            reasons.append("edit workflow")
        if VERIFY_INTENT_PATTERN.search(prompt):
            complexity += 2
            reasons.append("verification requested")
        if multiline_request or long_request:
            complexity += 1
            reasons.append("larger request")
        if complexity >= 5:
            return MAX_ADAPTIVE_TOOL_STEPS, reasons
        if complexity >= 2:
            return min(MAX_ADAPTIVE_TOOL_STEPS, max(base_steps, 20)), reasons
        return base_steps, reasons

    def _should_skip_repo_retrieval(self, prompt: str) -> bool:
        return bool(READ_INTENT_PATTERN.search(prompt) and extract_file_tokens(prompt))

    async def _run_async(
        self,
        prompt: str,
        callback: Callable[[str, str], None] | None = None,
    ) -> str:
        self._active_callback = callback
        try:
            self.memory.add_turn("user", prompt)
            self._raise_if_cancelled()
            if self.skills.warnings:
                for warning in self.skills.warnings:
                    self._emit(callback, "status", f"Skill warning: {warning}")
            self._emit(callback, "status", f"Loaded {self.skills.count()} local skill(s) from .skills.")
            active_skills = self.skills.select_for_prompt(prompt)
            active_skill_context = self.skills.render_active_context(active_skills)
            if active_skills:
                names = ", ".join(skill.name for skill in active_skills)
                self._emit(callback, "status", f"Activated local skill(s): {names}")
            try:
                existing_model_path = resolve_gguf_model_path(
                    self.runtime_workspace,
                    self.config.model_path,
                    self.config.selected_model_filename,
                )
            except (FileNotFoundError, ValueError) as exc:
                raise RuntimeError(f"Configured GGUF model path is invalid: {exc}") from exc
            if existing_model_path is None:
                self._emit(
                    callback,
                    "status",
                    (
                        f"No local GGUF model was found for {DEFAULT_GGUF_MODEL_LABEL}. Downloading "
                        f"{self.config.selected_model_filename} from Hugging Face into .cache/models/..."
                    ),
                )
                downloaded_model_path = download_default_gguf_model(
                    self.runtime_workspace,
                    self.config.selected_model_filename,
                )
                self.config.model_path = str(downloaded_model_path)
                self._emit(callback, "status", f"Downloaded GGUF model to {downloaded_model_path}")
            elif self.config.model_path is None:
                self.config.model_path = str(existing_model_path)
            self._emit(
                callback,
                "status",
                (
                    "Retrieval backend preference: "
                    f"{self.config.retrieval_backend} "
                    "(default auto stays on exact flat cuVS search; set "
                    "QUBITZ_RETRIEVAL_BACKEND=ivf_flat|ivf_pq|cagra to opt into ANN)."
                ),
            )
            self._emit(
                callback,
                "status",
                (
                    "Adaptive repository context budget: "
                    f"up to {self.retriever.recommended_result_limit()} retrieved chunk(s) "
                    f"for num_ctx={self.config.num_ctx}."
                ),
            )
            self._emit(
                callback,
                "status",
                "Preparing repository context before loading the generation model to keep more VRAM free for embeddings.",
            )
            skip_repo_retrieval = self._should_skip_repo_retrieval(prompt)
            if skip_repo_retrieval:
                self._emit(
                    callback,
                    "status",
                    "Skipping repository retrieval for this explicit file-read request so the model can inspect the target file with read_file first.",
                )
                repo_context = (
                    "Repository retrieval was skipped for this request because the user explicitly asked to read "
                    "named file(s); inspect those files directly with read_file before relying on repo retrieval."
                )
            else:
                repo_context = self.retriever.format_context(prompt)
                self.retriever.release_gpu_resources()
            memory_context = self.memory.build_context(prompt)
            if skip_repo_retrieval:
                self._emit(callback, "status", "Memory context prepared; repository retrieval was skipped.")
            else:
                self._emit(callback, "status", "Repository and memory context prepared.")
            self._raise_if_cancelled()

            configured_server_path = (
                self.config.llama_server_path or os.environ.get(LLAMACPP_SERVER_PATH_ENV_NAME) or ""
            ).strip()
            configured_server_url = (os.environ.get(LLAMACPP_SERVER_URL_ENV_NAME) or "").strip()
            if (
                not configured_server_path
                and not configured_server_url
                and normalize_base_url(self.config.server_url) == DEFAULT_LLAMACPP_BASE_URL
            ):
                missing_runtime = llamacpp_runtime_missing_files(self.runtime_workspace)
                if missing_runtime:
                    try:
                        self._emit(
                            callback,
                            "status",
                            (
                                "Project-local llama.cpp runtime is missing required backend files. "
                                "Downloading the latest official Windows CUDA 12 runtime from GitHub releases into .cache..."
                            ),
                        )
                        runtime_info = ensure_project_local_llamacpp_runtime(self.runtime_workspace)
                        self.config.llama_server_path = str(runtime_info["executable"])
                        self._emit(
                            callback,
                            "status",
                            f"Downloaded llama.cpp runtime {runtime_info['release_tag']} to {runtime_info['runtime_dir']}",
                        )
                    except Exception as exc:
                        if not in_wsl():
                            raise
                        self._emit(
                            callback,
                            "status",
                            (
                                "Windows CUDA runtime bootstrap was unavailable; "
                                "downloading the llama.cpp source tarball and building the native WSL backend instead. "
                                f"Reason: {type(exc).__name__}: {shorten(str(exc), 300)}"
                            ),
                        )
                        runtime_info = ensure_project_local_native_llamacpp_runtime(self.runtime_workspace)
                        self.config.llama_server_path = str(runtime_info["executable"])
                        self._emit(
                            callback,
                            "status",
                            (
                                f"Native WSL llama.cpp backend ready at {runtime_info['executable']} "
                                f"(log: {runtime_info['build_log']})"
                            ),
                        )
                else:
                    local_runtime_executable = llamacpp_runtime_dir(self.runtime_workspace) / "llama-server.exe"
                    if local_runtime_executable.exists():
                        self.config.llama_server_path = str(local_runtime_executable.resolve())
                        self._emit(
                            callback,
                            "status",
                            f"Using cached Windows llama.cpp runtime at {local_runtime_executable.parent}",
                        )

            self._emit(callback, "status", "Detecting the local llama.cpp GGUF backend and validating the target model.")
            llm = self._get_llm()
            resolved_model_name = llm.ensure_model(self.config.model_name)
            model_key = (llm.label, resolved_model_name)
            self._validated_model_keys.add(model_key)
            self._emit(callback, "status", f"llama.cpp transport: {llm.label} @ {llm.base_url}")
            if resolved_model_name != self.config.model_name:
                self._emit(
                    callback,
                    "status",
                    (
                        f"Using the single loaded server model id {resolved_model_name!r} "
                        f"instead of requested alias {self.config.model_name!r}."
                    ),
                )
            diagnostics = self._startup_diagnostics_cache.get(model_key)
            if diagnostics is None:
                diagnostics = llm.startup_diagnostics(resolved_model_name)
                self._startup_diagnostics_cache[model_key] = diagnostics
            if diagnostics.get("model_path"):
                self._emit(callback, "status", f"GGUF model path: {diagnostics['model_path']}")
            if diagnostics.get("model_path_error"):
                self._emit(callback, "status", f"GGUF model path warning: {diagnostics['model_path_error']}")
            if diagnostics.get("server_executable"):
                self._emit(callback, "status", f"llama.cpp executable: {diagnostics['server_executable']}")
            if diagnostics.get("server_executable_error"):
                self._emit(callback, "status", f"llama.cpp executable warning: {diagnostics['server_executable_error']}")
            if diagnostics.get("launched"):
                self._emit(callback, "status", "llama.cpp server was auto-started for this session.")
            if diagnostics.get("server_log_path"):
                self._emit(callback, "status", f"llama.cpp server log: {diagnostics['server_log_path']}")
            if diagnostics.get("props_error"):
                self._emit(callback, "status", f"llama.cpp server warning: {diagnostics['props_error']}")
            runtime = diagnostics.get("runtime")
            if runtime is not None:
                self._emit(
                    callback,
                    "status",
                    (
                        f"llama.cpp model ready: {runtime.get('id', resolved_model_name)} "
                        f"owned_by={runtime.get('owned_by', 'llama.cpp')}"
                    ),
                )
            self._raise_if_cancelled()
            self._emit(callback, "status", "Starting model loop.")

            async with AsyncExitStack() as exit_stack:
                mcp_host: MCPHost | None = None
                if self._tool_definitions_cache is None:
                    mcp_host = await exit_stack.enter_async_context(MCPHost(self.workspace))
                    tools = await mcp_host.list_tools()
                    self._tool_definitions_cache = build_model_tools(tools)
                    self._tool_count_cache = len(tools)
                self._emit(callback, "status", f"Loaded {self._tool_count_cache} MCP tool(s) for the model.")
                tool_definitions = list(self._tool_definitions_cache or [])
                messages: list[dict[str, Any]] = [
                    {
                        "role": "system",
                        "content": self._system_prompt(
                            memory_context,
                            active_skill_context,
                            self.history_summary,
                        ),
                    }
                ]
                messages.extend(self.history[-(HISTORY_TURNS * 2) :])
                messages.append(
                    {
                        "role": "user",
                        "content": self._user_message(prompt, repo_context, active_skills),
                    }
                )

                step_budget, step_budget_reasons = self._adaptive_step_budget(prompt)
                unlimited_steps = step_budget <= 0
                if unlimited_steps:
                    self._emit(callback, "status", "Adaptive tool-step budget for this request: unlimited.")
                elif step_budget > self.config.max_steps:
                    reason_text = ", ".join(dict.fromkeys(step_budget_reasons)) or "request complexity"
                    self._emit(
                        callback,
                        "status",
                        f"Adaptive tool-step budget raised to {step_budget} for this request ({reason_text}).",
                    )
                else:
                    self._emit(callback, "status", f"Adaptive tool-step budget for this request: {step_budget}.")

                repeated_calls: dict[str, int] = {}
                step_limit_label = "unlimited" if unlimited_steps else str(step_budget)
                step = 1
                while unlimited_steps or step <= step_budget:
                    self._raise_if_cancelled()
                    self._apply_side_notes(messages, callback)
                    active_context_tokens = self._estimate_active_context(messages, tool_definitions)
                    self._emit(
                        callback,
                        "status",
                        (
                            f"Model step {step}/{step_limit_label}: waiting for the next answer or tool call. "
                            f"Estimated active context ~{active_context_tokens} tokens, "
                            f"num_ctx={self.config.num_ctx}, num_predict={self.config.num_predict}."
                        ),
                    )
                    response = llm.chat(
                        model_name=resolved_model_name,
                        messages=messages,
                        tools=tool_definitions,
                        num_predict=self.config.num_predict,
                        temperature=self.config.temperature,
                        top_p=self.config.top_p,
                        min_p=self.config.min_p,
                        repeat_penalty=self.config.repeat_penalty,
                    )
                    self._raise_if_cancelled()
                    message = response.get("message") or {}
                    tool_calls = message.get("tool_calls") or []
                    content = (message.get("content") or "").strip()
                    if tool_calls:
                        assistant_message = {
                            "role": "assistant",
                            "content": content,
                            "tool_calls": tool_calls,
                        }
                        messages.append(assistant_message)
                        for tool_call in tool_calls:
                            function = tool_call.get("function") or {}
                            tool_call_id = tool_call.get("id") or ""
                            name = function.get("name", "").strip()
                            arguments = clean_arguments(function.get("arguments"))
                            call_key = json.dumps({"name": name, "arguments": arguments}, sort_keys=True)
                            repeated_calls[call_key] = repeated_calls.get(call_key, 0) + 1
                            if repeated_calls[call_key] > 2:
                                tool_payload = {
                                    "is_error": True,
                                    "content_text": f"Refusing repeated tool call for {name} after 2 repeats.",
                                }
                            else:
                                if mcp_host is None:
                                    mcp_host = await exit_stack.enter_async_context(MCPHost(self.workspace))
                                self._emit(callback, "tool", describe_tool_action(name, arguments))
                                self._raise_if_cancelled()
                                tool_result = await mcp_host.call_tool(name, arguments)
                                self._raise_if_cancelled()
                                tool_payload = serialize_mcp_result(tool_result)
                                self._emit(callback, "tool", summarize_tool_result(name, tool_payload))
                            messages.append(
                                {
                                    "role": "tool",
                                    "tool_call_id": tool_call_id,
                                    "content": shorten(
                                        json.dumps(tool_payload, ensure_ascii=True, indent=2),
                                        MAX_TOOL_RESULT_CHARS,
                                    ),
                                }
                            )
                        step += 1
                        continue
                    if content:
                        if self._apply_side_notes(messages, callback, assistant_content=content):
                            step += 1
                            continue
                        self._raise_if_cancelled()
                        self.memory.add_turn("assistant", content)
                        self.history.extend(
                            [
                                {"role": "user", "content": prompt},
                                {"role": "assistant", "content": content},
                            ]
                        )
                        self._compact_history()
                        return content
                    messages.append({"role": "assistant", "content": ""})
                    messages.append(
                        {
                            "role": "user",
                            "content": "You returned neither tool calls nor a final answer. Either call a tool or answer directly.",
                        }
                    )
                    step += 1
            final_error = (
                "Stopped after reaching the maximum tool steps for this request."
                if step_budget > 0
                else "Stopped without a final answer."
            )
            self.memory.add_turn("assistant", final_error)
            return final_error
        except RunCancelled:
            final_error = "Interrupted by user."
            self.memory.add_turn("assistant", final_error)
            return final_error
        finally:
            with self._side_notes_lock:
                self._pending_side_notes.clear()
            self._cancel_event.clear()
            self._active_callback = None

    def run_sync(self, prompt: str, callback: Callable[[str, str], None] | None = None) -> str:
        with self._side_notes_lock:
            self._pending_side_notes.clear()
        self._cancel_event.clear()
        return asyncio.run(self._run_async(prompt, callback))
