# <QUBITZ_SHARED_SYMBOL:base:755436587284afd7> module/ClassDef:SkillDefinition:0
@dataclass
class SkillDefinition:
    name: str
    description: str
    root: Path
    skill_file: Path
    body: str
    license: str = ""
    compatibility: str = ""
    metadata: dict[str, str] = field(default_factory=dict)
    allowed_tools: str = ""

    def to_summary(self, workspace: Path) -> dict[str, Any]:
        resource_paths: list[str] = []
        for folder in ("scripts", "references", "assets"):
            base = self.root / folder
            if not base.exists():
                continue
            for candidate in sorted(base.rglob("*")):
                if candidate.is_file():
                    resource_paths.append(relative_path(candidate, workspace))
        return {
            "name": self.name,
            "description": self.description,
            "license": self.license or None,
            "compatibility": self.compatibility or None,
            "allowed_tools": self.allowed_tools or None,
            "metadata": self.metadata,
            "root": relative_path(self.root, workspace),
            "skill_file": relative_path(self.skill_file, workspace),
            "resources": resource_paths,
        }
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:76c108a3467c6be7> module/FunctionDef:ensure_project_local_llamacpp_runtime:0
def ensure_project_local_llamacpp_runtime(workspace: Path) -> dict[str, Any]:
    runtime_dir = llamacpp_runtime_dir(workspace)
    missing_before = llamacpp_runtime_missing_files(workspace)
    runtime_executable = runtime_dir / "llama-server.exe"
    if not missing_before and runtime_executable.exists():
        return {
            "executable": runtime_executable.resolve(),
            "downloaded": False,
            "release_tag": None,
            "runtime_dir": runtime_dir.resolve(),
            "missing_before": [],
        }
    release = fetch_latest_llamacpp_release()
    release_tag = str(release.get("tag_name") or "").strip() or "latest"
    main_asset, cudart_asset = select_latest_llamacpp_cuda_assets(release)
    downloads_dir = workspace / ".cache" / "downloads" / "llama.cpp" / release_tag
    tmp_root = workspace / ".cache" / "tmp" / f"llama.cpp-{release_tag}"
    main_zip = downloads_dir / str(main_asset["name"])
    cudart_zip = downloads_dir / str(cudart_asset["name"])
    if not main_zip.exists():
        download_url_to_path(str(main_asset["browser_download_url"]), main_zip)
    if not cudart_zip.exists():
        download_url_to_path(str(cudart_asset["browser_download_url"]), cudart_zip)
    main_extract = tmp_root / "main"
    cudart_extract = tmp_root / "cudart"
    extract_zip_to_dir(main_zip, main_extract)
    extract_zip_to_dir(cudart_zip, cudart_extract)
    runtime_dir.mkdir(parents=True, exist_ok=True)
    for source_dir in (main_extract, cudart_extract):
        archive_root = normalize_archive_root(source_dir)
        for source in archive_root.iterdir():
            target = runtime_dir / source.name
            if source.is_dir():
                if target.exists():
                    shutil.rmtree(target)
                shutil.copytree(source, target)
            else:
                shutil.copy2(source, target)
    missing_after = llamacpp_runtime_missing_files(workspace)
    if missing_after or not runtime_executable.exists():
        raise RuntimeError(
            "Automatic llama.cpp runtime download finished, but required files are still missing: "
            + ", ".join(missing_after or ["llama-server.exe"])
        )
    return {
        "executable": runtime_executable.resolve(),
        "downloaded": True,
        "release_tag": release_tag,
        "runtime_dir": runtime_dir.resolve(),
        "missing_before": missing_before,
    }
