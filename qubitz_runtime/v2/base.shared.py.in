# <QUBITZ_SHARED_SYMBOL:base:7cececeb3bca824a> module/FunctionDef:canonicalize_workspace_script:0
def canonicalize_workspace_script(working_directory: Path, script: str) -> str:
    normalized = script.strip()
    activation_match = re.match(
        r"^\s*(?P<activate>\.[\\/][^;]*?[\\/](?:Scripts[\\/]Activate\.ps1|bin[\\/]activate))\s*;\s*(?P<rest>.+)$",
        normalized,
        flags=re.IGNORECASE,
    )
    if activation_match:
        activate_path = normalize_workspace_text(activation_match.group("activate"))
        rest = strip_leading_python_launcher(activation_match.group("rest"))
        activate_candidate = (working_directory / Path(activate_path)).resolve()
        if activate_candidate.name.lower() == "activate.ps1":
            interpreter = activate_candidate.parent / "python.exe"
            if interpreter.exists():
                translated = wsl_path_to_windows_path(interpreter)
                return f"& {powershell_single_quote(translated)} {rest}"
    python_match = re.match(
        r"^\s*(?P<python>\.[\\/][^;]*?[\\/](?:Scripts[\\/]python\.exe|bin[\\/]python))\s*(?P<rest>.*)$",
        normalized,
        flags=re.IGNORECASE,
    )
    if python_match:
        interpreter = (working_directory / Path(normalize_workspace_text(python_match.group("python")))).resolve()
        if interpreter.exists():
            rest = python_match.group("rest").strip()
            target = wsl_path_to_windows_path(interpreter) if interpreter.suffix.lower() == ".exe" else str(interpreter)
            return f"& {powershell_single_quote(target)} {rest}".rstrip()
    return script
