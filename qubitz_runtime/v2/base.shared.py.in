# <QUBITZ_SHARED_SYMBOL:base:9a0ade0f682b55b3> module/FunctionDef:fetch_latest_llamacpp_release:0
def fetch_latest_llamacpp_release() -> dict[str, Any]:
    if os.environ.get("QUBITZ_OFFLINE") == "1":
        raise RuntimeError("Automatic llama.cpp runtime download is disabled because QUBITZ_OFFLINE=1.")
    with _httpx_client() as client:
        response = client.get(DEFAULT_LLAMACPP_RELEASE_API_URL)
        response.raise_for_status()
        payload = response.json()
    if not isinstance(payload, dict):
        raise RuntimeError("Unexpected GitHub release payload for llama.cpp.")
    return payload
