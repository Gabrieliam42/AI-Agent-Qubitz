# <QUBITZ_SHARED_SYMBOL:base:5e56fa83a69f9821> module/FunctionDef:shorten:0
def shorten(text: str, limit: int = 1200) -> str:
    if len(text) <= limit:
        return text
    return text[: limit - 3].rstrip() + "..."
