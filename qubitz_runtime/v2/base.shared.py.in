# <QUBITZ_SHARED_SYMBOL:base:19901ca68c0bbc01> module/ClassDef:AgentConfig:0
@dataclass
class AgentConfig:
    workspace: Path
    runtime_workspace: Path | None = None
    model_name: str = DEFAULT_MODEL
    model_path: str | None = None
    selected_model_filename: str = DEFAULT_GGUF_MODEL_FILENAME
    server_url: str = DEFAULT_LLAMACPP_BASE_URL
    llama_server_path: str | None = None
    embed_model_name: str = DEFAULT_EMBED_MODEL
    max_steps: int = MAX_TOOL_STEPS
    num_ctx: int = DEFAULT_NUM_CTX
    num_predict: int = DEFAULT_NUM_PREDICT
    temperature: float = DEFAULT_CHAT_TEMPERATURE
    top_p: float = DEFAULT_CHAT_TOP_P
    min_p: float = DEFAULT_CHAT_MIN_P
    repeat_penalty: float = DEFAULT_REPEAT_PENALTY
    local_files_only: bool = field(default_factory=default_local_files_only)
    embed_device: str = field(default_factory=default_embed_device)
    min_repo_chunks: int = field(default_factory=lambda: env_int("QUBITZ_MIN_REPO_CHUNKS", 4))
    max_repo_chunks: int = field(default_factory=lambda: env_int("QUBITZ_MAX_REPO_CHUNKS", 24))
    repo_chunk_ctx_tokens: int = field(default_factory=lambda: env_int("QUBITZ_REPO_CHUNK_CTX_TOKENS", 16384))
    embed_min_free_vram_gib: float = field(default_factory=lambda: env_float("QUBITZ_EMBED_MIN_FREE_VRAM_GIB", 0.0))
    retrieval_gpu_reserve_gib: float = field(default_factory=lambda: env_float("QUBITZ_RETRIEVAL_GPU_RESERVE_GIB", 1.0))
    retrieval_backend: str = field(default_factory=default_retrieval_backend)
    retrieval_ivf_nlist: int = field(default_factory=lambda: env_int("QUBITZ_RETRIEVAL_IVF_NLIST", 256))
    retrieval_ivf_nprobe: int = field(default_factory=lambda: env_int("QUBITZ_RETRIEVAL_IVF_NPROBE", 16))
    retrieval_ivfpq_m: int = field(default_factory=lambda: env_int("QUBITZ_RETRIEVAL_IVFPQ_M", 16))
    retrieval_ivfpq_bits: int = field(default_factory=lambda: env_int("QUBITZ_RETRIEVAL_IVFPQ_BITS", 8))
    retrieval_cagra_graph_degree: int = field(
        default_factory=lambda: env_int("QUBITZ_RETRIEVAL_CAGRA_GRAPH_DEGREE", 64)
    )
    retrieval_cagra_intermediate_graph_degree: int = field(
        default_factory=lambda: env_int("QUBITZ_RETRIEVAL_CAGRA_INTERMEDIATE_DEGREE", 128)
    )
    retrieval_cagra_search_width: int = field(
        default_factory=lambda: env_int("QUBITZ_RETRIEVAL_CAGRA_SEARCH_WIDTH", 32)
    )
    retrieval_rmm_pool_gib: float = field(default_factory=lambda: env_float("QUBITZ_RETRIEVAL_RMM_POOL_GIB", 0.0))
