# <QUBITZ_SHARED_SYMBOL:base:22e7cbbca8a696be> module/FunctionDef:is_explicit_absolute_path_text:0
def is_explicit_absolute_path_text(candidate: str) -> bool:
    normalized = candidate.strip()
    if not normalized:
        return False
    if WINDOWS_DRIVE_PATH_PATTERN.match(normalized):
        return True
    return Path(normalized).expanduser().is_absolute()
# </QUBITZ_SHARED_SYMBOL>
# <QUBITZ_SHARED_SYMBOL:base:235f181d4bf19136> module/FunctionDef:build_model_tools:0
def build_model_tools(tools: Sequence[mcp_types.Tool]) -> list[dict[str, Any]]:
    model_tools: list[dict[str, Any]] = []
    for tool in tools:
        parameters = tool.inputSchema or {"type": "object", "properties": {}}
        model_tools.append(
            {
                "type": "function",
                "function": {
                    "name": tool.name,
                    "description": tool.description or "",
                    "parameters": parameters,
                },
            }
        )
    return model_tools
